usage() {
  sed -n '3,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
install) shift && cmd_install "$@" ;;
status) shift && cmd_status "$@" ;;
check) shift && cmd_check "$@" ;;
directory) shift && cmd_directory "$@" ;;
engine) shift && cmd_engine "$@" ;;
fast-lane) shift && cmd_fast_lane "$@" ;;
folders) shift && cmd_folders "$@" ;;
backup-db) shift && cmd_backup_db "$@" ;;
backup) shift && cmd_backup "$@" ;;
backup-weekly) shift && cmd_backup_weekly "$@" ;;
snapshots) shift && cmd_snapshots "$@" ;;
restore) shift && cmd_restore "$@" ;;
restore-drill) shift && cmd_restore_drill "$@" ;;
install-backup) shift && cmd_install_backup "$@" ;;
install-timers) shift && cmd_install_timers "$@" ;;
install-mail) shift && cmd_install_mail "$@" ;;
upgrade) shift && cmd_upgrade "$@" ;;
tidy) cmd_tidy ;;
rollback) shift && cmd_rollback "$@" ;;
restore-dump) shift && cmd_restore_dump "$@" ;;
logs) shift && cmd_logs "$@" ;;
"" | -h | --help | help) usage ;;
*)
  red "There is no subcommand called '$1'."
  echo
  usage
  exit 1
  ;;
esac
