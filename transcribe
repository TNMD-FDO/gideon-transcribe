#!/usr/bin/env bash
#
# The one command an Admin runs on the server.
#
# Run it from the Install home, the folder this file is in. Every subcommand
# is meant to be safe to run twice, and none of them ever prints a secret.
#
#   ./transcribe install      ask the office facts and write both .env files
#   ./transcribe status       what is running, and whether it is healthy
#   ./transcribe check        the smoke checks, as a plain report
#   ./transcribe directory    ask the office's directory facts and write them
#   ./transcribe folders      make the app data folders, owned by the app account
#   ./transcribe backup-db    a dump of the database into the app data folder
#   ./transcribe upgrade TAG  fetch a release, take a dump, and bring it up
#   ./transcribe rollback TAG go back to a release, restoring the dump if need be
#   ./transcribe logs [name]  follow the logs of one service, or of all of them
#
# install refuses to overwrite an existing .env, secrets/, or tls/ unless it is
# given --reconfigure. install and upgrade pull the two images; --build builds
# them on the server instead, for an office that cannot reach the registry.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

ENV_FILE="$HERE/.env"
SECRETS="$HERE/secrets"
CA_DIR="$HERE/ca"

# The app's own account, which is what has to be able to read a secret file.
APP_USER="${APP_USER:-transcribe}"

green() { printf '\033[32m%s\033[0m\n' "$1"; }
amber() { printf '\033[33m%s\033[0m\n' "$1"; }
red() { printf '\033[31m%s\033[0m\n' "$1"; }

pass() { green "  pass  $1"; }
note() { amber "  note  $1"; }
fail() { red "  FAIL  $1"; FAILURES=$((FAILURES + 1)); }

FAILURES=0

need_env() {
  if [ ! -f "$ENV_FILE" ]; then
    red "There is no .env here. Run this from the Install home."
    exit 1
  fi
}

env_value() {
  # One value out of .env, without sourcing the file: a value with a space or
  # a comma in it is common in a directory DN and must not be word-split.
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -1
}

set_env() {
  local key="$1" value="$2"
  if grep -q "^${key}=" "$ENV_FILE"; then
    # A DN holds commas, equals signs, and spaces, so the replacement is done
    # in python rather than in sed, where every one of those is punctuation.
    python3 - "$ENV_FILE" "$key" "$value" <<'PY'
import sys
from pathlib import Path

path, key, value = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
lines = path.read_text(encoding="utf-8").splitlines()
out = []
done = False
for line in lines:
    if line.startswith(f"{key}=") and not done:
        out.append(f"{key}={value}")
        done = True
    else:
        out.append(line)
path.write_text("\n".join(out) + "\n", encoding="utf-8")
PY
  else
    printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}

ask() {
  # A question with what is there now as the default. Prints to stderr so the
  # answer alone comes back on stdout.
  local question="$1" now="$2" answer=""
  if [ -n "$now" ]; then
    printf '%s\n  [%s]: ' "$question" "$now" >&2
  else
    printf '%s\n  : ' "$question" >&2
  fi
  read -r answer
  printf '%s' "${answer:-$now}"
}

compose() {
  docker compose "$@"
}

# status -----------------------------------------------------------------------

cmd_status() {
  need_env
  echo "Gideon Transcribe at $(env_value APP_HOSTNAME)"
  echo
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
}

# logs -------------------------------------------------------------------------

cmd_logs() {
  need_env
  if [ $# -gt 0 ]; then
    compose logs -f --tail 200 "$1"
  else
    compose logs -f --tail 100
  fi
}

# directory --------------------------------------------------------------------

cmd_directory() {
  need_env
  cat <<'WORDS'
The office directory
--------------------
Sign-in is against the office's Active Directory over LDAPS on port 636.
Nothing you type here leaves this server, and none of it is ever committed to
the repository: it is written to .env and to a secret file beside it.

Press Enter to keep what is shown in brackets.

WORDS

  local enabled uri bind base signin admin
  enabled="$(ask "Is directory sign-in on? (yes or no; no means local admins only)" "$(env_value LDAP_ENABLED)")"

  case "$enabled" in
    y | yes | true | on | 1) enabled=true ;;
    *) enabled=false ;;
  esac
  set_env LDAP_ENABLED "$enabled"

  if [ "$enabled" != "true" ]; then
    echo
    amber "Directory sign-in is off. Only local admins can sign in."
    return 0
  fi

  echo
  uri="$(ask "The directory, by domain name and never one controller
  (for example ldaps://example.internal:636)" "$(env_value LDAP_SERVER_URI)")"
  set_env LDAP_SERVER_URI "$uri"

  echo
  bind="$(ask "The read-only bind account, as its User logon name
  (for example svc-transcribe@example.internal)" "$(env_value LDAP_BIND_USER)")"
  set_env LDAP_BIND_USER "$bind"

  echo
  base="$(ask "The domain's base DN, under which people are found
  (for example DC=example,DC=internal)" "$(env_value LDAP_SEARCH_BASE)")"
  set_env LDAP_SEARCH_BASE "$base"

  echo
  signin="$(ask "The sign-in group's full DN
  (for example CN=Transcribe Users,OU=Groups,DC=example,DC=internal)" "$(env_value LDAP_SIGNIN_GROUP)")"
  set_env LDAP_SIGNIN_GROUP "$signin"

  echo
  admin="$(ask "The admin group's full DN, or blank for no group-held admins" "$(env_value LDAP_ADMIN_GROUP)")"
  set_env LDAP_ADMIN_GROUP "$admin"

  set_env LDAP_CA_FILE "$(env_value LDAP_CA_FILE)"
  set_env LDAP_BIND_PASSWORD_FILE "./secrets/ldap_bind_password"

  # The CA root ----------------------------------------------------------------
  echo
  mkdir -p "$CA_DIR"
  local ca_file="$CA_DIR/office-root.pem"
  if [ -s "$ca_file" ]; then
    green "The office CA root is in place ($(wc -c <"$ca_file") bytes)."
  else
    amber "There is no office CA root at $ca_file."
    echo "  Put the PEM there and run this again. Leave it empty only if the"
    echo "  domain controllers' certificates come from a public authority."
    : >"$ca_file"
  fi

  # The bind password ----------------------------------------------------------
  echo
  mkdir -p "$SECRETS"
  chmod 700 "$SECRETS"
  local password="" again=""
  printf 'The bind account'"'"'s password (nothing is shown as you type;\n  press Enter alone to keep the one already stored): ' >&2
  read -rs password
  echo >&2

  if [ -n "$password" ]; then
    printf 'And again: ' >&2
    read -rs again
    echo >&2
    if [ "$password" != "$again" ]; then
      red "Those did not match. Nothing was written."
      return 1
    fi
    printf '%s' "$password" >"$SECRETS/ldap_bind_password"
    chmod 600 "$SECRETS/ldap_bind_password"
    if id "$APP_USER" >/dev/null 2>&1; then
      # The app runs as its own account and has to be able to read the file.
      sudo chown "$APP_USER:$APP_USER" "$SECRETS/ldap_bind_password" 2>/dev/null ||
        amber "Could not give the file to $APP_USER; run: sudo chown $APP_USER:$APP_USER $SECRETS/ldap_bind_password"
      sudo chmod 400 "$SECRETS/ldap_bind_password" 2>/dev/null || true
    fi
    green "The bind password was written to secrets/ldap_bind_password."
  elif [ -s "$SECRETS/ldap_bind_password" ]; then
    green "The stored bind password was kept."
  else
    amber "There is no bind password stored. The directory will refuse every sign-in."
  fi

  echo
  echo "Written. Now restart the app and the workers so they read it:"
  echo
  echo "  docker compose up -d --force-recreate app worker media-worker"
  echo
  echo "Then prove it:"
  echo
  echo "  ./transcribe check"
}

# check ------------------------------------------------------------------------

cmd_check() {
  need_env
  FAILURES=0
  local hostname
  hostname="$(env_value APP_HOSTNAME)"

  echo "Gideon Transcribe: checks"
  echo

  echo "The server"
  if id "$APP_USER" >/dev/null 2>&1; then
    if id -nG "$APP_USER" | tr ' ' '\n' | grep -qx docker; then
      fail "the $APP_USER account is in the docker group, which is root on this server"
    else
      pass "the $APP_USER account exists and is not in the docker group"
    fi
  else
    fail "there is no $APP_USER account"
  fi

  local data
  data="$(env_value APP_DATA_DIR)"
  if [ -d "$data" ]; then
    local owner mode
    owner="$(stat -c '%U' "$data")"
    mode="$(stat -c '%a' "$data")"
    if [ "$owner" = "$APP_USER" ] && [ "$mode" = "750" ]; then
      pass "the app data folder is $owner's, mode $mode"
    else
      note "the app data folder is $owner's, mode $mode (expected $APP_USER, 750)"
    fi
  else
    fail "there is no app data folder at $data"
  fi

  for folder in scratch cases uploads; do
    if [ -d "$data/$folder" ]; then
      local sub_owner
      sub_owner="$(stat -c '%U' "$data/$folder")"
      if [ "$sub_owner" = "$APP_USER" ]; then
        pass "$folder/ is $sub_owner's"
      else
        fail "$data/$folder is $sub_owner's, not $APP_USER's; the app cannot write there. Fix: sudo chown -R $APP_USER:$APP_USER $data/$folder"
      fi
    else
      note "there is no $folder/ yet under $data; it is made when it is first needed"
    fi
  done

  local tag
  tag="$(git -C "$HERE" describe --exact-match --tags 2>/dev/null || true)"
  if [ -n "$tag" ]; then
    pass "the checkout is at the release tag $tag"
  else
    note "the checkout is not at a release tag (ADR 0007 allows this until v1.0.0)"
  fi

  local free
  free="$(df -BG --output=avail "$data" 2>/dev/null | tail -1 | tr -dc '0-9')"
  if [ -n "$free" ] && [ "$free" -gt 200 ]; then
    pass "the disk has ${free} GB free"
  else
    fail "the disk has only ${free:-?} GB free"
  fi

  echo
  echo "The name and the certificate"
  if getent hosts "$hostname" >/dev/null 2>&1; then
    pass "$hostname resolves"
  else
    note "$hostname does not resolve on this server (it may resolve on the workstations)"
  fi

  if [ -s "$HERE/tls/cert.pem" ]; then
    local ends
    ends="$(openssl x509 -in "$HERE/tls/cert.pem" -noout -enddate 2>/dev/null | cut -d= -f2)"
    if openssl x509 -in "$HERE/tls/cert.pem" -noout -checkend 2592000 >/dev/null 2>&1; then
      pass "the certificate is good until $ends"
    else
      fail "the certificate expires within 30 days ($ends)"
    fi
    if openssl x509 -in "$HERE/tls/cert.pem" -noout -text |
      grep -q "$hostname"; then
      pass "the certificate names $hostname"
    else
      fail "the certificate does not name $hostname"
    fi
  else
    fail "there is no certificate at tls/cert.pem"
  fi

  echo
  echo "The containers"
  local unhealthy
  unhealthy="$(compose ps --format '{{.Service}} {{.State}} {{.Status}}' 2>/dev/null |
    grep -v 'running' || true)"
  if [ -z "$unhealthy" ]; then
    pass "every container is running"
  else
    fail "not every container is running:"
    printf '%s\n' "$unhealthy" | sed 's/^/        /'
  fi

  echo
  echo "The directory"
  if [ "$(env_value LDAP_ENABLED)" != "true" ]; then
    note "directory sign-in is off: local admins only"
  else
    # The same four checks the panel's button runs, so an office is never told
    # two different things about one directory.
    compose exec -T app python -c "
from core import directory
for one in directory.test_connection():
    mark = 'note' if one['warning'] else ('pass' if one['ok'] else 'FAIL')
    print(f\"  {mark}  {one['name']}: {one['says']}\")
" 2>/dev/null || fail "the checks could not be run (is the app up?)"
  fi

  echo
  echo "The WhisperX service"
  if compose exec -T app python -c "
from core import whisperx
raise SystemExit(0 if whisperx.is_alive() else 1)
" >/dev/null 2>&1; then
    pass "the service answers"
  else
    fail "the service does not answer"
  fi

  echo
  if [ "$FAILURES" -eq 0 ]; then
    green "Everything checked passed."
  else
    red "$FAILURES check(s) failed."
    exit 1
  fi
}


# install ----------------------------------------------------------------------

SERVICE_ENV="$HERE/whisperx-service/.env"
SERVICE_SECRETS="$HERE/whisperx-service/secrets"

cmd_install() {
  local reconfigure=no build=no
  for one in "$@"; do
    case "$one" in
    --reconfigure) reconfigure=yes ;;
    --build) build=yes ;;
    *)
      red "install takes --reconfigure and --build and nothing else."
      exit 1
      ;;
    esac
  done

  if [ -f "$ENV_FILE" ] && [ "$reconfigure" = "no" ]; then
    red "There is already a .env here."
    echo "  install will not overwrite it, a secret, or a certificate."
    echo "  To change the office facts, run:  ./transcribe install --reconfigure"
    echo "  To change only the directory:     ./transcribe directory"
    exit 1
  fi

  echo "Gideon Transcribe: install"
  echo
  echo "This asks for the facts about this office and writes them to two"
  echo "environment files beside this script. Nothing you type here leaves"
  echo "this server, and none of it is ever committed to the repository."
  echo

  prerequisites || exit 1

  [ -f "$ENV_FILE" ] || cp "$HERE/.env.example" "$ENV_FILE"
  [ -f "$SERVICE_ENV" ] || cp "$HERE/whisperx-service/.env.example" "$SERVICE_ENV"

  ask_the_office_facts
  ask_the_gpu
  make_the_secrets
  cmd_directory
  ask_the_hugging_face_token
  make_the_data_folders

  echo
  echo "Written. What is left, in order:"
  echo
  echo "  1. Put the certificate and its key in tls/ (cert.pem and key.pem,"
  echo "     the key mode 0600), and the office CA root in ca/office-root.pem."
  if [ "$build" = "yes" ]; then
    echo "  2. docker compose build"
  else
    echo "  2. docker compose pull        (or run install --build to build here)"
  fi
  echo "  3. docker compose run --rm whisperx pull"
  echo "  4. docker compose up -d"
  echo "  5. docker compose run --rm app create-local-admin"
  echo "  6. ./transcribe check"
}

prerequisites() {
  echo "Checking what this server has:"
  local ok=yes

  if command -v docker >/dev/null 2>&1; then
    pass "docker $(docker --version | sed 's/Docker version //; s/,.*//')"
  else
    fail "there is no docker on this server"
    ok=no
  fi

  if docker compose version >/dev/null 2>&1; then
    pass "the compose plugin $(docker compose version --short)"
  else
    fail "the docker compose plugin is not installed"
    ok=no
  fi

  if command -v nvidia-smi >/dev/null 2>&1; then
    pass "the nvidia driver $(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)"
  else
    fail "nvidia-smi is not on this server, so no GPU can be reserved"
    ok=no
  fi

  if id "$APP_USER" >/dev/null 2>&1; then
    pass "the $APP_USER account exists"
  else
    fail "there is no $APP_USER account; the install guide's server preparation makes it"
    ok=no
  fi

  echo
  [ "$ok" = "yes" ]
}

ask_the_office_facts() {
  local value

  echo
  value="$(ask "The address people will use, without https://
  (for example transcribe.example.internal)" "$(env_value APP_HOSTNAME)")"
  set_env APP_HOSTNAME "$value"

  echo
  value="$(ask "The port it answers on" "$(env_value HTTPS_PORT)")"
  set_env HTTPS_PORT "${value:-8443}"

  echo
  value="$(ask "The server's own LAN address to listen on, so this is off
  every other interface the machine has" "$(env_value BIND_ADDRESS)")"
  set_env BIND_ADDRESS "$value"

  echo
  value="$(ask "Who may connect, as networks separated by spaces
  (for example 10.0.0.0/8 192.168.0.0/16)" "$(env_value ALLOWED_CLIENT_CIDRS)")"
  set_env ALLOWED_CLIENT_CIDRS "$value"

  echo
  value="$(ask "The app data folder, on the largest drive and not the OS drive" "$(env_value APP_DATA_DIR)")"
  set_env APP_DATA_DIR "$value"

  echo
  value="$(ask "The time zone" "$(env_value TZ)")"
  set_env TZ "${value:-UTC}"
  set_service_env TZ "${value:-UTC}"

  # The app runs as its own account, and compose needs its numbers.
  if id "$APP_USER" >/dev/null 2>&1; then
    set_env APP_UID "$(id -u "$APP_USER")"
    set_env APP_GID "$(id -g "$APP_USER")"
    set_service_env APP_UID "$(id -u "$APP_USER")"
    set_service_env APP_GID "$(id -g "$APP_USER")"
    green "The app will run as $APP_USER ($(id -u "$APP_USER"):$(id -g "$APP_USER"))."
  fi
}

make_the_data_folders() {
  # Caddy is given scratch/ and cases/ as read-only mounts. Docker creates a
  # missing mount source as root, and the app would then never be able to
  # write into it, so both are made here with the right owner before anything
  # starts. Made and not asked about: the app decides its own layout inside
  # the folder the office chose.
  local data
  data="$(env_value APP_DATA_DIR)"
  [ -n "$data" ] || return 0

  local made=""
  for folder in scratch cases uploads; do
    if [ ! -d "$data/$folder" ]; then
      sudo mkdir -p "$data/$folder" || return 0
      made="$made $folder"
    fi
    sudo chown "$APP_USER:$APP_USER" "$data/$folder" 2>/dev/null || true
    sudo chmod 750 "$data/$folder" 2>/dev/null || true
  done

  if [ -n "$made" ]; then
    green "Made$made under $data, owned by $APP_USER."
  fi
}

ask_the_gpu() {
  echo
  echo "The GPUs on this server:"
  nvidia-smi -L | sed 's/^/  /'
  echo
  echo "The WhisperX service reserves one card by its UUID, never by its"
  echo "number, so that adding a card cannot move it onto somebody else's."
  local value
  value="$(ask "Paste the UUID of the card the service should use
  (the GPU-... part above)" "$(service_env_value WHISPERX_GPU_UUID)")"
  set_service_env WHISPERX_GPU_UUID "$value"
}

make_the_secrets() {
  echo
  mkdir -p "$SECRETS" "$SERVICE_SECRETS"
  chmod 700 "$SECRETS" "$SERVICE_SECRETS"

  # The random ones are made here and never typed by anybody.
  random_secret "$SECRETS/django_secret_key" "the Django key"
  random_secret "$SECRETS/postgres_password" "the database password"

  if [ -s "$SECRETS/whisperx_consumer_token" ]; then
    green "The WhisperX consumer token was already made."
  else
    local token
    token="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    printf '%s' "$token" >"$SECRETS/whisperx_consumer_token"
    chmod 600 "$SECRETS/whisperx_consumer_token"
    # The service reads its consumers from a file of its own, one per line.
    printf 'transcribe      %s\n' "$token" >>"$SERVICE_SECRETS/tokens"
    chmod 600 "$SERVICE_SECRETS/tokens"
    green "The WhisperX consumer token was made and added to the service's tokens file."
  fi

  own_the_secrets
}

random_secret() {
  local path="$1" what="$2"
  if [ -s "$path" ]; then
    green "$what was already made."
    return
  fi
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$path"
  chmod 600 "$path"
  green "$what was made."
}

own_the_secrets() {
  # Every secret is read inside a container that runs as the app's account.
  if id "$APP_USER" >/dev/null 2>&1; then
    sudo chown -R "$APP_USER:$APP_USER" "$SECRETS" "$SERVICE_SECRETS" 2>/dev/null ||
      amber "Could not give the secrets to $APP_USER; run: sudo chown -R $APP_USER:$APP_USER secrets whisperx-service/secrets"
    sudo chmod 400 "$SECRETS"/* "$SERVICE_SECRETS"/* 2>/dev/null || true
    sudo chmod 700 "$SECRETS" "$SERVICE_SECRETS" 2>/dev/null || true
  fi
}

ask_the_hugging_face_token() {
  echo
  echo "The diarization model is fetched once from Hugging Face, with a token"
  echo "belonging to an account that has accepted the model's conditions."
  echo "It is used at install and at upgrade and never while the app runs."
  local token again
  printf 'The Hugging Face token (nothing is shown as you type;\n  press Enter alone to keep the one already stored): ' >&2
  read -rs token
  echo >&2

  if [ -n "$token" ]; then
    printf 'And again: ' >&2
    read -rs again
    echo >&2
    if [ "$token" != "$again" ]; then
      red "Those did not match. Nothing was written."
      return 1
    fi
    printf '%s' "$token" >"$SERVICE_SECRETS/hf_token"
    chmod 600 "$SERVICE_SECRETS/hf_token"
    own_the_secrets
    green "The Hugging Face token was written."
  elif [ -s "$SERVICE_SECRETS/hf_token" ]; then
    green "The stored Hugging Face token was kept."
  else
    amber "There is no Hugging Face token stored; the model pull will refuse."
  fi
}

service_env_value() {
  [ -f "$SERVICE_ENV" ] || return 0
  sed -n "s/^$1=//p" "$SERVICE_ENV" | tail -1
}

set_service_env() {
  [ -f "$SERVICE_ENV" ] || return 0
  local key="$1" value="$2"
  if grep -q "^${key}=" "$SERVICE_ENV"; then
    python3 - "$SERVICE_ENV" "$key" "$value" <<'PY'
import sys
from pathlib import Path

path, key, value = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
lines = path.read_text(encoding="utf-8").splitlines()
out = []
done = False
for line in lines:
    if line.startswith(f"{key}=") and not done:
        out.append(f"{key}={value}")
        done = True
    else:
        out.append(line)
path.write_text("\n".join(out) + "\n", encoding="utf-8")
PY
  else
    printf '%s=%s\n' "$key" "$value" >>"$SERVICE_ENV"
  fi
}

# backup-db --------------------------------------------------------------------

cmd_folders() {
  # Docker creates a missing bind-mount source as root, and the app could then
  # never write into it. install and upgrade call this; it is a subcommand of
  # its own as well, because until v1.0.0 this server tracks main (ADR 0007)
  # and deploys by hand rather than through upgrade.
  echo "The app data folders:"
  make_the_data_folders

  local data
  data="$(env_value APP_DATA_DIR)"
  for folder in scratch cases uploads; do
    if [ -d "$data/$folder" ]; then
      pass "$folder/ is $(stat -c '%U' "$data/$folder")'s, mode $(stat -c '%a' "$data/$folder")"
    else
      fail "$data/$folder could not be made"
    fi
  done

  [ "$FAILURES" -eq 0 ] || exit 1
}

cmd_backup_db() {
  need_env
  local name="${1:-manual-$(date +%Y%m%d-%H%M%S)}"
  local folder
  folder="$(env_value APP_DATA_DIR)/backup"

  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$folder" 2>/dev/null || true

  echo "Taking a dump into $folder/$name.dump"
  compose exec -T postgres pg_dump \
    -U "$(env_value POSTGRES_USER)" \
    -d "$(env_value POSTGRES_DB)" \
    --format=custom >"/tmp/$name.dump"

  sudo install -o "$APP_USER" -g "$APP_USER" -m 0600 "/tmp/$name.dump" "$folder/$name.dump"
  rm -f "/tmp/$name.dump"
  green "Done: $(sudo du -h "$folder/$name.dump" | cut -f1)"
}

# upgrade ----------------------------------------------------------------------

cmd_upgrade() {
  need_env
  local tag="" build=no
  for one in "$@"; do
    case "$one" in
    --build) build=yes ;;
    *) tag="$one" ;;
    esac
  done

  if [ -z "$tag" ]; then
    red "Which release? For example: ./transcribe upgrade v1.0.0"
    exit 1
  fi

  echo "Upgrading to $tag"
  echo

  # 1. Never over running work.
  if running_jobs; then
    red "A job is running. An upgrade restarts the app, so wait for it."
    echo "  The queue page in the admin panel says what is running."
    exit 1
  fi
  pass "nothing is running"

  # 2. Never over somebody's local edits.
  if ! git -C "$HERE" diff --quiet || ! git -C "$HERE" diff --cached --quiet; then
    red "There are local edits to tracked files here."
    git -C "$HERE" status --short | sed 's/^/    /'
    echo "  An upgrade would lose them. Put them somewhere, then try again."
    exit 1
  fi
  pass "no local edits"

  # 3 and 4. The dump and the configuration, before anything changes.
  cmd_backup_db "pre-$tag"
  keep_the_configuration "$tag"

  # 5. The code, by fetch and checkout, which never touches an ignored file.
  echo
  echo "Fetching $tag"
  git -C "$HERE" fetch --tags --quiet
  if ! git -C "$HERE" rev-parse "$tag" >/dev/null 2>&1; then
    red "There is no release called $tag."
    exit 1
  fi
  read_the_release_lines "$tag"
  git -C "$HERE" checkout --quiet "$tag"
  pass "the checkout is at $tag"

  # 6 and 7. The images, then up. The folders first: a release can add one
  # Caddy mounts, and Docker would create a missing mount source as root,
  # which the app could then never write into.
  make_the_data_folders

  echo
  if [ "$build" = "yes" ]; then
    compose build
  else
    compose pull --quiet || amber "The registry could not be reached; building instead."
    [ "$build" = "yes" ] || compose build 2>/dev/null || true
  fi
  compose up -d

  # 8. The models, when the release says they changed.
  if models_changed "$tag"; then
    echo
    amber "This release changes the models, so they are fetched now."
    compose run --rm whisperx pull
  fi

  echo
  cmd_check
}

keep_the_configuration() {
  local tag="$1"
  local folder
  folder="$(env_value APP_DATA_DIR)/backup"
  echo "Keeping this office's configuration in $folder/config-pre-$tag.tar"
  tar -cf "/tmp/config-pre-$tag.tar" -C "$HERE" \
    .env secrets tls ca whisperx-service/.env whisperx-service/secrets 2>/dev/null || true
  sudo install -o "$APP_USER" -g "$APP_USER" -m 0600 \
    "/tmp/config-pre-$tag.tar" "$folder/config-pre-$tag.tar"
  rm -f "/tmp/config-pre-$tag.tar"
}

read_the_release_lines() {
  # Every release's notes begin with two fixed lines: whether the models
  # changed and whether the database migrates. They are read out before
  # anything is done, because they are what decides whether this upgrade is
  # a quiet one.
  local tag="$1"
  echo
  echo "What $tag says about itself:"
  git -C "$HERE" show "$tag:CHANGELOG.md" 2>/dev/null |
    sed -n "/^## $tag/,/^## /p" | grep -E '^(Models|Database):' | sed 's/^/  /' ||
    amber "  its changelog says nothing about models or the database"
  echo
}

models_changed() {
  git -C "$HERE" show "$1:CHANGELOG.md" 2>/dev/null |
    sed -n "/^## $1/,/^## /p" | grep -qE '^Models: *changed'
}

running_jobs() {
  compose exec -T app python -c "
from core.jobs import Job, JobState
raise SystemExit(0 if Job.objects.filter(state__in=JobState.LIVE).exists() else 1)
" >/dev/null 2>&1
}

# rollback ---------------------------------------------------------------------

cmd_rollback() {
  need_env
  local tag="${1:-}"
  if [ -z "$tag" ]; then
    red "Which release? For example: ./transcribe rollback v0.9.0"
    echo
    echo "  The releases this checkout knows about:"
    git -C "$HERE" tag --sort=-creatordate | head -10 | sed 's/^/    /'
    exit 1
  fi

  echo "Rolling back to $tag"
  git -C "$HERE" checkout --quiet "$tag"
  compose up -d

  echo
  amber "If the app will not start because a migration cannot be reversed,"
  echo "  restore the dump taken before the upgrade:"
  echo
  echo "    ./transcribe restore-dump $(env_value APP_DATA_DIR)/backup/pre-<the tag you left>.dump"
  echo
  cmd_check
}

cmd_restore_dump() {
  need_env
  local dump="${1:-}"
  if [ ! -f "$dump" ]; then
    red "There is no dump at ${dump:-<nothing given>}."
    exit 1
  fi

  red "This replaces everything in the database with what is in that file."
  printf '  Type the word yes to go on: ' >&2
  local said
  read -r said
  [ "$said" = "yes" ] || { echo "Nothing was done."; return 0; }

  compose stop app worker media-worker
  sudo cat "$dump" | compose exec -T postgres pg_restore \
    -U "$(env_value POSTGRES_USER)" \
    -d "$(env_value POSTGRES_DB)" \
    --clean --if-exists --no-owner
  compose up -d
  green "Restored."
}

# ------------------------------------------------------------------------------

usage() {
  sed -n '3,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
install) shift && cmd_install "$@" ;;
status) shift && cmd_status "$@" ;;
check) shift && cmd_check "$@" ;;
directory) shift && cmd_directory "$@" ;;
folders) shift && cmd_folders "$@" ;;
backup-db) shift && cmd_backup_db "$@" ;;
upgrade) shift && cmd_upgrade "$@" ;;
rollback) shift && cmd_rollback "$@" ;;
restore-dump) shift && cmd_restore_dump "$@" ;;
logs) shift && cmd_logs "$@" ;;
"" | -h | --help | help) usage ;;
*)
  red "There is no subcommand called '$1'."
  echo
  usage
  exit 1
  ;;
esac
