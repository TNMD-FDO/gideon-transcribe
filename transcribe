# engine -----------------------------------------------------------------------

ensure_the_token_file() {
  # The engine's token is a Compose secret, and a secret whose file is missing
  # stops the whole stack with an error about the file. An office with no
  # engine still has to start, so the file always exists: empty until
  # ./transcribe engine fills it. Called by install and by every upgrade, so an
  # install from before the AI assistant existed comes up as before.
  if ! secret_exists "$SECRETS/llm_api_token"; then
    write_secret "$SECRETS/llm_api_token" ""
    own_the_secrets
  fi
}

cmd_engine() {
  need_env
  # `engine local on` and `engine local off` are the Local engine's switch;
  # plain `engine` is the conversation about a shared one.
  if [ "${1:-}" = "local" ]; then
    case "${2:-}" in
      on) cmd_engine_local_on ;;
      off) cmd_engine_local_off ;;
      *)
        red "Say 'on' or 'off': ./transcribe engine local on"
        return 1
        ;;
    esac
    return
  fi
  cat <<'WORDS'
The AI assistant's engine
-------------------------
The AI assistant talks to a language-model engine. An office that already runs
one (a vLLM with an OpenAI-compatible API, on this server or on the LAN) points
the app at it: the app joins that engine's Docker network and presents its
token. An office with none can start the Local engine instead, or leave the
assistant off; everything else works without it.

Nothing you type here leaves this server, and none of it is ever committed to
the repository. Press Enter to keep what is shown in brackets.

WORDS

  ensure_the_token_file

  local network shared_engine_settings=""
  network="$(ask "The Docker network the engine listens on, as 'docker network ls'
  shows it. Blank means no shared engine (the Local engine, or none)" "$(env_value LLM_NETWORK)")"

  if [ -n "$network" ] && [ "$network" != "transcribe-llm" ]; then
    if ! docker network inspect "$network" >/dev/null 2>&1; then
      amber "There is no Docker network called '$network' on this server."
      echo "  'docker network ls' lists them. Nothing was written."
      return 1
    fi
    set_env LLM_NETWORK "$network"
    # Compose reads the second file only when .env names it. The line is
    # written whole, never left empty: an empty COMPOSE_FILE is read as a path
    # and Compose refuses to start.
    set_env COMPOSE_FILE "compose.yaml:compose.shared-engine.yaml"
    # The two are never on together: a Local engine still running would hold
    # its card for nothing while the app talks to the shared one.
    if local_engine_is_on; then
      echo "  The Local engine is on; stopping it, since the app will use the shared one."
      stop_the_local_engine
    fi
    green "The app will join '$network' to reach the engine."
    # The panel's two provider settings, so nobody has to type them twice.
    # Blank keeps what the panel holds, for the office that set them there.
    local address model
    address="$(ask "The engine's address on that network (for example http://<its name>:8000/v1)" "")"
    model="$(ask "The model name the engine serves (its --served-model-name)" "")"
    shared_engine_settings="$address|$model"
  else
    set_env LLM_NETWORK "transcribe-llm"
    # Drop the shared-engine line if it was there; the default is compose.yaml
    # alone. Commented rather than deleted, so the shape stays visible.
    if grep -q '^COMPOSE_FILE=' "$ENV_FILE"; then
      sed -i 's/^COMPOSE_FILE=/# COMPOSE_FILE=/' "$ENV_FILE"
    fi
    echo
    echo "  No shared engine. To run the Local engine on this server instead,"
    echo "  './transcribe engine local on'; or leave the assistant off."
  fi

  # The token --------------------------------------------------------------------
  echo
  local token again
  printf 'The engine'"'"'s bearer token (nothing is shown as you type;\n  press Enter alone to keep the one already stored, or to leave it empty): ' >&2
  read -rs token
  echo >&2
  if [ -n "$token" ]; then
    printf 'And again: ' >&2
    read -rs again
    echo >&2
    if [ "$token" != "$again" ]; then
      red "Those did not match. The token was not changed."
      return 1
    fi
    write_secret "$SECRETS/llm_api_token" "$token"
    own_the_secrets
    green "The engine token was written to secrets/llm_api_token."
  elif secret_present "$SECRETS/llm_api_token"; then
    green "The stored engine token was kept."
  else
    amber "No engine token is stored. The AI assistant stays off until there is one."
  fi
  # The panel settings, once the token is in place: the command runs in the
  # app container, which is up whenever the stack is.
  if [ -n "${shared_engine_settings:-}" ]; then
    address="${shared_engine_settings%%|*}"
    model="${shared_engine_settings#*|}"
    [ -n "$address" ] && panel_set engine_address "$address"
    [ -n "$model" ] && panel_set engine_model "$model"
  fi
  echo
  echo "  A change here reaches the workers at the next 'docker compose up -d'."
  echo "  Then, on the Panel's Status page, press Test connection; when it answers"
  echo "  'ready', turn the AI assistant toggle on (Settings, AI assistant)."
}

# The Local engine ----------------------------------------------------------------
#
# A vLLM this stack starts on its own, behind the `llm` Compose profile, serving a
# small model under the name `local-engine`. For an office with no shared engine,
# or one that wants the assistant without leaning on somebody else's. It shares
# a card with WhisperX, so it is given a share of that card's memory and no
# more; the default, 0.21 of a 96 GB card, is 20 GB for the default model and
# its cache, which leaves WhisperX everything it needs.

LOCAL_MODEL_DEFAULT="Qwen/Qwen3.5-4B"
LOCAL_SHARE_DEFAULT="0.21"

panel_set() {
  # One admin setting from here, through the same checks and audit row as the
  # panel. The value is quoted so that an empty one reaches the command; the
  # worker's start-up chatter and the static-files warning around the command's
  # own line are dropped.
  compose exec -T app python manage.py set_setting --skip-checks "$1" "$2" </dev/null 2>&1 \
    | grep -v "procrastinate\|^$" || true
}

local_engine_is_on() {
  profile_on llm
}

least_busy_gpu() {
  # The card with the least memory in use right now, by UUID: on a server whose
  # other card carries a shared engine, that is the WhisperX card.
  nvidia-smi --query-gpu=uuid,memory.used --format=csv,noheader,nounits 2>/dev/null \
    | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' '
}

cmd_engine_local_on() {
  cat <<'WORDS'
The Local engine
----------------
A small language model this server runs itself for the AI assistant, beside
WhisperX on the same card, within a share of that card's memory. The first
start downloads the model's weights into the app data folder (about 8 GB for
the default) and takes some minutes; after that it starts in about a minute.

Nothing you type here leaves this server. Press Enter to keep what is shown in
brackets.

WORDS
  ensure_the_token_file

  if ! command -v nvidia-smi >/dev/null 2>&1; then
    red "nvidia-smi is not on this server, so no card can be named. Nothing was written."
    return 1
  fi
  echo "The cards on this server:"
  nvidia-smi --query-gpu=index,name,memory.total,memory.used,uuid --format=csv,noheader 2>/dev/null | sed 's/^/  /'
  echo

  local gpu model share
  gpu="$(ask "The card the engine runs on, by UUID (the one WhisperX uses)" \
    "$( [ -n "$(env_value LLM_LOCAL_GPU_UUID)" ] && [ "$(env_value LLM_LOCAL_GPU_UUID)" != "<GPU UUID>" ] && env_value LLM_LOCAL_GPU_UUID || least_busy_gpu)")"
  if ! nvidia-smi -L 2>/dev/null | grep -q "$gpu"; then
    red "No card on this server has the UUID '$gpu'. Nothing was written."
    return 1
  fi
  model="$(ask "The model, as Hugging Face names it" "$( [ -n "$(env_value LLM_LOCAL_MODEL)" ] && env_value LLM_LOCAL_MODEL || echo "$LOCAL_MODEL_DEFAULT")")"
  share="$(ask "The share of the card's memory the engine may use (0.21 of 96 GB is 20 GB)" "$( [ -n "$(env_value LLM_LOCAL_GPU_FRACTION)" ] && env_value LLM_LOCAL_GPU_FRACTION || echo "$LOCAL_SHARE_DEFAULT")")"
  case "$share" in
    0.[0-9]*|0,[0-9]*) ;;
    *) red "The share is a fraction between 0 and 1, like 0.21. Nothing was written."; return 1 ;;
  esac

  set_env LLM_LOCAL_GPU_UUID "$gpu"
  set_env LLM_LOCAL_MODEL "$model"
  set_env LLM_LOCAL_GPU_FRACTION "$share"
  set_env LLM_NETWORK "transcribe-llm"
  profile_add llm
  # The Local engine lives on the project network, so the shared-engine file
  # has nothing to add; commented rather than deleted, so the shape stays visible.
  if grep -q '^COMPOSE_FILE=' "$ENV_FILE"; then
    sed -i 's/^COMPOSE_FILE=/# COMPOSE_FILE=/' "$ENV_FILE"
  fi

  # The engine refuses to start without a token, and the app presents the same
  # one, so the file is filled with a random one when it is empty. A shared
  # engine's token already there is kept: it is the same file, and the person
  # switching back to the shared engine would not thank us for losing it.
  if ! secret_present "$SECRETS/llm_api_token"; then
    write_secret "$SECRETS/llm_api_token" "$(openssl rand -hex 32)"
    own_the_secrets
    green "A token for the Local engine was written to secrets/llm_api_token."
  fi

  echo
  echo "Starting the engine (the first start downloads the model)..."
  compose up -d
  # The panel's two provider settings, so the app talks to what was started.
  # The command's own line is what matters; the worker's start-up chatter and
  # the static-files warning around it are not.
  panel_set engine_address "http://vllm:8000/v1"
  panel_set engine_model "local-engine"
  echo
  green "The Local engine is on: $model on card $gpu, within $share of its memory."
  echo "  Watch it come up with:   ./transcribe logs vllm"
  echo "  Then, on the Panel's Status page, press Test connection. When it answers"
  echo "  'ready', turn the AI assistant toggle on (Settings, AI assistant)."
  echo "  ./transcribe engine local off stops it and frees the card."
}

cmd_engine_local_off() {
  # Off means the app uses no engine: the container goes, and the panel stops
  # pointing at it, so nobody sees a greyed button for an engine that is not
  # there and the Status page reads "off; no engine is configured". A shared
  # engine is named afterwards with './transcribe engine', which sets the
  # panel again.
  stop_the_local_engine
  panel_set engine_address ""
  panel_set engine_model ""
  panel_set assistant_available off
  green "The Local engine is off and its card is free. The weights stay in the app"
  echo "  data folder for the next 'on'; delete data/models/vllm to free the disk."
  echo "  The AI assistant is off and points at no engine. To use one again:"
  echo "  './transcribe engine' for a shared one, or 'engine local on'."
}

stop_the_local_engine() {
  if local_engine_is_on; then
    compose --profile llm stop vllm 2>/dev/null || true
    compose --profile llm rm -f vllm 2>/dev/null || true
  fi
  profile_remove llm
}

# fast-lane ---------------------------------------------------------------------

fast_lane_is_on() {
  profile_on fast
}

cmd_fast_lane() {
  case "${1:-}" in
    on) cmd_fast_lane_on ;;
    off) cmd_fast_lane_off ;;
    *)
      red "fast-lane takes 'on' or 'off'."
      exit 1
      ;;
  esac
}

ask_the_fast_lane() {
  # Asked at install, after the card: one question, and no by default.
  echo
  echo "The fast lane is a second copy of the transcription service, for what"
  echo "must not wait behind a long job: a recording made in the app, and later"
  echo "the interpreter. It needs about eight gigabytes of the card's memory."
  echo "Without it those still work, at the front of the one service's line."
  local answer
  answer="$(ask "Turn on the fast lane? (yes or no)" "$( fast_lane_is_on && echo yes || echo no)")"
  case "$answer" in
    y|Y|yes|YES|Yes) turn_the_fast_lane_on quiet ;;
    *) ;;
  esac
}

turn_the_fast_lane_on() {
  need_env
  local gpu state
  gpu="$(service_env_value WHISPERX_GPU_UUID)"
  # The same card as the service unless the .env already names another.
  if [ -z "$(service_env_value WHISPERX_FAST_GPU_UUID)" ] \
    || [ "$(service_env_value WHISPERX_FAST_GPU_UUID)" = "<GPU UUID>" ]; then
    set_service_env WHISPERX_FAST_GPU_UUID "$gpu"
  fi
  state="$(service_env_value WHISPERX_FAST_STATE_DIR)"
  case "$state" in
    ""|/replace/with/*)
      state="$(service_env_value WHISPERX_STATE_DIR)-fast"
      set_service_env WHISPERX_FAST_STATE_DIR "$state"
      ;;
  esac
  # Docker would make a missing state folder as root, and the service could
  # then never write into it; made here with the service's own owner.
  if [ -n "$state" ] && ! look test -d "$state"; then
    sudo install -d -m 0750 -o "$(service_env_value WHISPERX_UID)" -g "$(service_env_value WHISPERX_GID)" "$state" 2>/dev/null \
      || amber "Could not make $state; make it, owned by the service's account, before starting."
  fi
  set_env WHISPERX_FAST_URL "http://whisperx-fast:8000"
  profile_add fast
  if [ "${1:-}" != "quiet" ]; then
    echo
    echo "Starting the fast lane..."
    compose up -d
    echo
    green "The fast lane is on, beside the service on card $(service_env_value WHISPERX_FAST_GPU_UUID)."
    echo "  Watch it come up with:   ./transcribe logs whisperx-fast"
    echo "  The Panel's Status page has a Fast lane card; ./transcribe check asks it."
    echo "  ./transcribe fast-lane off stops it and frees the memory."
  else
    green "The fast lane is on; it starts with the stack."
  fi
}

cmd_fast_lane_on() {
  cat <<'WORDS'
The fast lane
-------------
A second copy of the transcription service, beside the first on the same
card, for what must not wait behind a long job: a recording made in the app,
and later the pieces of one transcribed while it records, and the
interpreter. About eight gigabytes of the card's memory for the default
model. It shares the model folder and has a state folder of its own.

WORDS
  turn_the_fast_lane_on
}

cmd_fast_lane_off() {
  need_env
  if fast_lane_is_on; then
    compose --profile fast stop whisperx-fast 2>/dev/null || true
    compose --profile fast rm -f whisperx-fast 2>/dev/null || true
  fi
  profile_remove fast
  set_env WHISPERX_FAST_URL ""
  # The app's containers read the address at start, so they are brought up
  # again to forget it; nothing else changes.
  compose up -d
  green "The fast lane is off and its memory is free. Recordings made in the app"
  echo "  go to the front of the one service's line, as they did before."
}

cmd_folders() {
  # Docker creates a missing bind-mount source as root, and the app could then
  # never write into it. install and upgrade call this; it is a subcommand of
  # its own as well, because until v1.0.0 this server tracks main (ADR 0007)
  # and deploys by hand rather than through upgrade.
  echo "The app data folders:"
  make_the_data_folders

  local data
  data="$(env_value APP_DATA_DIR)"
  for folder in scratch cases uploads; do
    # Plain sudo here, not the report's `sudo -n`: this subcommand has already
    # asked for a password, so it may ask again if the timestamp has gone.
    if sudo test -d "$data/$folder"; then
      pass "$folder/ is $(sudo stat -c '%U' "$data/$folder")'s, mode $(sudo stat -c '%a' "$data/$folder")"
    else
      fail "$data/$folder could not be made"
    fi
  done

  [ "$FAILURES" -eq 0 ] || exit 1
}

cmd_backup_db() {
  need_env
  local name="${1:-manual-$(date +%Y%m%d-%H%M%S)}"
  local folder
  folder="$(env_value APP_DATA_DIR)/backup"

  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$folder" 2>/dev/null || true

  echo "Taking a dump into $folder/$name.dump"
  compose exec -T postgres pg_dump \
    -U "$(env_value POSTGRES_USER)" \
    -d "$(env_value POSTGRES_DB)" \
    --format=custom >"/tmp/$name.dump"

  sudo install -o "$APP_USER" -g "$APP_USER" -m 0600 "/tmp/$name.dump" "$folder/$name.dump"
  rm -f "/tmp/$name.dump"
  green "Done: $(sudo du -h "$folder/$name.dump" | cut -f1)"
}

# Backup and restore (Phase 2, chapter 9) -----------------------------------------
#
# Nightly, a host timer runs `./transcribe backup`: one consistent dump of the
# database, the manifest, and then restic carries the dump, cases/, and the
# configuration into an encrypted, deduplicated repository over SFTP on the
# office's backup store. restic runs as the Compose service `backup` behind
# its own profile; the repository password and the store account's key are
# its secrets and no other service's, and the app never sees either: the two
# are checked here, on the host, before anything runs. `restore <snapshot>`
# brings the whole app back to one night; `restore-drill` proves, monthly and
# by itself, that the newest Snapshot restores, into a throwaway project that
# is torn down afterwards.

BACKUP_IMAGE_LINE='image: restic/restic:'

backup_target() { env_value BACKUP_TARGET; }
backup_on() { [ -n "$(backup_target)" ]; }
backup_user_host() {
  # sftp:account@store:/folder -> account@store
  local target="$1"
  target="${target#sftp:}"
  printf '%s' "${target%%:*}"
}
backup_folder_path() {
  local target="$1"
  target="${target#sftp:}"
  printf '%s' "${target#*:}"
}
backup_secret_file() { printf '%s/%s' "$HERE" "${1#./}"; }

# The ssh restic uses: the account's key and the store's recorded host key,
# nothing else, and no prompt ever.
backup_ssh_options() {
  printf '%s' "-i /run/secrets/backup_ssh_key -o UserKnownHostsFile=/run/secrets/backup_known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=20"
}

# The restic container runs as the app's account, and ssh will not run as a
# user its passwd file does not know, so a one-line passwd is written for the
# container before every run, beside restic's cache.
backup_prepare() {
  local folder uid gid
  folder="$(env_value APP_DATA_DIR)/backup"
  uid="$(env_value APP_UID)"; gid="$(env_value APP_GID)"
  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$folder" "$folder/.restic-cache" "$folder/config" 2>/dev/null || true
  # Docker makes a missing bind-mount source as a directory; one left by a
  # run that reached the container first is removed so the file can be written.
  if sudo test -d "$folder/.passwd"; then sudo rmdir "$folder/.passwd" 2>/dev/null || sudo rm -rf "$folder/.passwd"; fi
  printf 'root:x:0:0:root:/root:/bin/sh\ntranscribe:x:%s:%s:Gideon Transcribe:/tmp:/bin/sh\n' "$uid" "$gid" \
    | sudo tee "$folder/.passwd" >/dev/null
  sudo chown "$APP_USER:$APP_USER" "$folder/.passwd"; sudo chmod 0644 "$folder/.passwd"
}

# The configuration the Snapshot carries, staged as a copy the container can
# read: .env and the WhisperX service's .env, both secrets folders, tls/ and
# ca/, with the two backup secrets left out. Owned by the app's account, 0700,
# and remade on every run so a change on the box is in that night's copy.
stage_config() {
  local folder="$(env_value APP_DATA_DIR)/backup/config"
  sudo rm -rf "$folder"
  sudo install -d -m 0700 "$folder" "$folder/secrets" "$folder/tls" "$folder/ca" "$folder/whisperx-secrets"
  [ -f "$ENV_FILE" ] && sudo cp "$ENV_FILE" "$folder/env"
  [ -f "$HERE/whisperx-service/.env" ] && sudo cp "$HERE/whisperx-service/.env" "$folder/whisperx-env"
  for name in $(sudo ls "$SECRETS" 2>/dev/null); do
    case "$name" in backup_password|backup_ssh_key) ;; *) sudo cp "$SECRETS/$name" "$folder/secrets/$name" ;; esac
  done
  sudo cp -a "$HERE/tls/." "$folder/tls/" 2>/dev/null || true
  sudo cp -a "$HERE/ca/." "$folder/ca/" 2>/dev/null || true
  sudo cp -a "$HERE/whisperx-service/secrets/." "$folder/whisperx-secrets/" 2>/dev/null || true
  sudo chown -R "$APP_USER:$APP_USER" "$folder"
  sudo chmod -R u+rX,go-rwx "$folder"
}

# restic with the nightly mounts: cases/ and the configuration read-only,
# backup/ read-write. Arguments are restic's own.
restic_ro() {
  local user_host
  user_host="$(backup_user_host "$(backup_target)")"
  backup_prepare
  compose --profile backup run --rm -T backup \
    -o "sftp.command=ssh $(backup_ssh_options) $user_host -s sftp" "$@"
}

# restic with the store's data written into place: for a restore. Run through
# docker directly so cases/ and a target folder can be mounted read-write;
# the image reference is the one compose.yaml pins, read from it.
restic_rw() {
  local target_dir="$1"
  shift
  local image user_host
  image="$(grep -o 'restic/restic:[^ ]*' "$HERE/compose.yaml" | head -1)" || true
  user_host="$(backup_user_host "$(backup_target)")"
  backup_prepare
  docker run --rm \
    --user "$(env_value APP_UID):$(env_value APP_GID)" \
    -v "$(env_value APP_DATA_DIR)/backup/.passwd:/etc/passwd:ro" \
    -e RESTIC_REPOSITORY="$(backup_target)" \
    -e RESTIC_PASSWORD_FILE=/run/secrets/backup_password \
    -e RESTIC_CACHE_DIR=/cache -e HOME=/tmp \
    -v "$(backup_secret_file "$(env_value BACKUP_KEY_FILE)"):/run/secrets/backup_password:ro" \
    -v "$(backup_secret_file "$(env_value BACKUP_SSH_KEY_FILE)"):/run/secrets/backup_ssh_key:ro" \
    -v "$(backup_secret_file "$(env_value BACKUP_KNOWN_HOSTS_FILE)"):/run/secrets/backup_known_hosts:ro" \
    -v "$(env_value APP_DATA_DIR)/backup/.restic-cache:/cache" \
    -v "$target_dir:/restore" \
    --network transcribe \
    "$image" \
    -o "sftp.command=ssh $(backup_ssh_options) $user_host -s sftp" "$@"
}

app_command() {
  # One of the app's management commands, inside the running app container.
  compose exec -T app python manage.py "$@" </dev/null
}

record_backup_failure() {
  # step, reason
  red "Backup failed at $1 ($2)."
  app_command record_backup failed --step "$1" --reason "$2" 2>/dev/null | grep -v procrastinate || true
  exit 1
}

cmd_backup() {
  need_env
  local started step folder data today dump
  started="$(date +%s)"
  data="$(env_value APP_DATA_DIR)"
  folder="$data/backup"
  today="$(date +%Y-%m-%d)"
  dump="nightly-$today.dump"

  # 1. Preflight: on the host, the target and the two secrets the app never
  # sees; in the app, the room on the App data folder.
  step=preflight
  if ! backup_on; then
    amber "BACKUP_TARGET is empty, so backups are off. Nothing was done."
    exit 0
  fi
  for key in BACKUP_SSH_KEY_FILE BACKUP_KEY_FILE BACKUP_KNOWN_HOSTS_FILE; do
    if ! secret_present "$(backup_secret_file "$(env_value "$key")")"; then
      record_backup_failure "$step" "target_unreachable"
    fi
  done
  local said
  said="$(app_command backup_preflight 2>/dev/null | grep -v procrastinate | tail -1)" || true
  if [ "$said" != "ok" ]; then
    record_backup_failure "$step" "${said:-disk_full}"
  fi

  # 2. The dump, the same as backup-db's, named for the night.
  step=dump
  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$folder" 2>/dev/null || true
  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$folder/.restic-cache" 2>/dev/null || true
  if ! compose exec -T postgres pg_dump -U "$(env_value POSTGRES_USER)" -d "$(env_value POSTGRES_DB)" --format=custom >"/tmp/$dump"; then
    rm -f "/tmp/$dump"
    record_backup_failure "$step" "dump_failed"
  fi
  sudo install -o "$APP_USER" -g "$APP_USER" -m 0600 "/tmp/$dump" "$folder/$dump"
  rm -f "/tmp/$dump"
  local dump_bytes
  dump_bytes="$(sudo stat -c %s "$folder/$dump")"

  # 3. The manifest, written by the app so the drill checks with the same code.
  step=manifest
  if ! app_command write_manifest 2>/dev/null | grep -q "manifest written"; then
    record_backup_failure "$step" "manifest_failed"
  fi

  # 4. The Snapshot: the newest dump, the manifest, cases/, and the configuration.
  step=snapshot
  stage_config
  if ! restic_ro cat config >/dev/null 2>&1; then
    record_backup_failure "$step" "target_unreachable"
  fi
  if ! restic_ro backup --host transcribe --tag nightly \
      "/backup/backup/$dump" /backup/backup/manifest.json /backup/cases /backup/config; then
    record_backup_failure "$step" "snapshot_failed"
  fi

  # 5. The keep rule. prune and check are the weekly slot's.
  step=forget
  if ! restic_ro forget --tag nightly --keep-daily "$(env_value BACKUP_KEEP_DAYS)" --quiet; then
    record_backup_failure "$step" "prune_failed"
  fi

  # 6. Local dumps: the last BACKUP_LOCAL_DUMPS nightly dumps; pre-upgrade
  # dumps and their configuration copies once they are 7 days past a newer
  # release than their own.
  step=local-dumps
  local keep current
  keep="$(env_value BACKUP_LOCAL_DUMPS)"
  sudo ls -1 "$folder" | grep '^nightly-.*\.dump$' | sort | head -n -"${keep:-7}" | while read -r old; do
    sudo rm -f "$folder/$old"
  done
  current="$(env_value RELEASE_TAG)"
  sudo find "$folder" -maxdepth 1 \( -name 'pre-*.dump' -o -name 'config-pre-*.tar' \) -mtime +7 2>/dev/null | while read -r old; do
    case "$old" in *"$current"*) ;; *) sudo rm -f "$old" ;; esac
  done

  # 7. Report to the app: the Status line and the audit row.
  step=record
  local held size
  held="$(restic_ro snapshots --tag nightly --json 2>/dev/null | tr -d '\n' | grep -o '"short_id"' | wc -l | tr -d ' ')" || true
  size="$(restic_ro stats --mode raw-data --json 2>/dev/null | grep -o '"total_size":[0-9]*' | head -1 | cut -d: -f2)" || true
  app_command record_backup ok --duration "$(( $(date +%s) - started ))" \
    --dump-bytes "$dump_bytes" --snapshot-bytes "${size:-0}" --held "${held:-0}" 2>/dev/null | grep -v procrastinate || true
  green "Backup done: $dump, ${held:-?} Snapshots held, $(( ( $(date +%s) - started ) ))s."
}

cmd_backup_weekly() {
  need_env
  backup_on || { amber "BACKUP_TARGET is empty, so backups are off."; exit 0; }
  echo "Pruning the repository..."
  if ! restic_ro prune --quiet; then record_backup_failure "prune" "prune_failed"; fi
  echo "Checking a tenth of the data..."
  if ! restic_ro check --read-data-subset=10% --quiet; then record_backup_failure "check" "check_failed"; fi
  green "Weekly prune and check done."
}

cmd_snapshots() {
  need_env
  backup_on || { amber "BACKUP_TARGET is empty, so backups are off."; exit 0; }
  echo "Snapshots in $(backup_target):"
  restic_ro snapshots --tag nightly
  echo
  echo "Restore one with:  ./transcribe restore <id>   (or 'latest')"
}

cmd_restore() {
  need_env
  local snapshot="${1:-}"
  if [ -z "$snapshot" ]; then
    red "Say which Snapshot: ./transcribe restore latest, or an id from ./transcribe snapshots."
    exit 1
  fi
  backup_on || { red "BACKUP_TARGET is empty; there is nothing to restore from."; exit 1; }
  for key in BACKUP_SSH_KEY_FILE BACKUP_KEY_FILE; do
    if ! secret_present "$(backup_secret_file "$(env_value "$key")")"; then
      red "$(env_value "$key") is empty. On a fresh box it comes from the office's password manager."
      exit 1
    fi
  done
  local data folder
  data="$(env_value APP_DATA_DIR)"
  folder="$data/backup"

  # The manifest first: the checkout must be at the release the Snapshot names.
  echo "Reading the Snapshot's manifest..."
  local manifest release snap_time snap_id
  manifest="$(restic_ro dump "$snapshot" /backup/backup/manifest.json 2>/dev/null)" || {
    red "That Snapshot could not be read. ./transcribe snapshots lists them."
    exit 1
  }
  release="$(printf '%s' "$manifest" | grep -o '"release": *"[^"]*"' | head -1 | cut -d'"' -f4)" || true
  snap_time="$(printf '%s' "$manifest" | grep -o '"written_at": *"[^"]*"' | head -1 | cut -d'"' -f4)" || true
  snap_id="$(restic_ro snapshots "$snapshot" --json 2>/dev/null | grep -o '"short_id": *"[^"]*"' | head -1 | cut -d'"' -f4)" || true
  local here_tag
  here_tag="$(git -C "$HERE" describe --tags --exact-match 2>/dev/null || echo "not at a tag")"
  if [ -n "$release" ] && [ "$release" != "$here_tag" ]; then
    red "This checkout is at $here_tag; the Snapshot was taken at $release."
    echo "  Check out that release first:  git -C $HERE checkout $release"
    echo "  then run this restore again, and upgrade afterwards."
    exit 1
  fi
  local running
  running="$(compose exec -T postgres psql -U "$(env_value POSTGRES_USER)" -d "$(env_value POSTGRES_DB)" -tAc "select count(*) from core_job where state in ('queued','running')" 2>/dev/null | tr -d ' ')"
  if [ -n "$running" ] && [ "$running" != "0" ]; then
    red "$running job(s) are queued or running. Let them finish or cancel them on the Queue page first."
    exit 1
  fi

  cat <<WORDS

A restore takes the app back to $(printf '%s' "$snap_time" | cut -c1-16 | tr T ' ') (Snapshot ${snap_id:-$snapshot},
release $release), and everything done after that is gone: every recording
uploaded, every correction, every case chat since then. Workspaces are
discarded and everybody is signed out.

WORDS
  printf 'Type RESTORE to go on, anything else to stop: '
  read -r answer
  [ "$answer" = "RESTORE" ] || { echo "Nothing was changed."; exit 0; }

  echo "Stopping the stack..."
  compose down --remove-orphans

  # The configuration, over the fresh files, keeping the two backup secrets.
  echo "Putting back the configuration..."
  local work
  work="$(mktemp -d /tmp/transcribe-restore.XXXXXX)"
  chmod 755 "$work"
  sudo chown "$APP_USER:$APP_USER" "$work"
  restic_rw "$work" restore "$snapshot" --target /restore --include /backup/config --quiet
  local got="$work/backup/config"
  sudo test -f "$got/env" && sudo install -m 0600 "$got/env" "$ENV_FILE"
  for name in $(sudo ls "$got/secrets" 2>/dev/null); do
    case "$name" in backup_password|backup_ssh_key) ;; *) sudo install -m 0400 "$got/secrets/$name" "$SECRETS/$name" ;; esac
  done
  sudo test -d "$got/tls" && sudo cp -a "$got/tls/." "$HERE/tls/" 2>/dev/null
  sudo test -d "$got/ca" && sudo cp -a "$got/ca/." "$HERE/ca/" 2>/dev/null
  sudo test -f "$got/whisperx-env" && sudo install -m 0600 "$got/whisperx-env" "$HERE/whisperx-service/.env"
  sudo test -d "$got/whisperx-secrets" && sudo cp -a "$got/whisperx-secrets/." "$HERE/whisperx-service/secrets/" 2>/dev/null
  own_the_secrets

  # cases/ in full, and the dump into backup/.
  echo "Putting back the cases and the dump (this is the long part)..."
  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$folder" "$folder/.restic-cache" "$data/cases"
  restic_rw "$data" restore "$snapshot" --target /restore --include /backup/cases --include /backup/backup --quiet
  # restic keeps the path as it was inside the container: /restore/backup/cases -> data/backup/cases.
  if sudo test -d "$data/backup/cases"; then
    sudo rsync -a --delete "$data/backup/cases/" "$data/cases/" 2>/dev/null || sudo cp -a "$data/backup/cases/." "$data/cases/"
    sudo rm -rf "$data/backup/cases"
  fi
  if sudo test -d "$data/backup/backup"; then
    sudo cp -a "$data/backup/backup/." "$folder/"
    sudo rm -rf "$data/backup/backup"
  fi
  local dump
  dump="$(printf '%s' "$manifest" | grep -o '"dump": *"[^"]*"' | head -1 | cut -d'"' -f4)" || true
  [ -n "$dump" ] && sudo test -f "$folder/$dump" || { red "The Snapshot's dump ($dump) is not there after the restore."; exit 1; }

  # The database: empty, then the dump.
  echo "Loading the database..."
  compose up -d postgres
  local tries=0
  until compose exec -T postgres pg_isready -U "$(env_value POSTGRES_USER)" -d postgres >/dev/null 2>&1; do
    tries=$((tries + 1)); [ "$tries" -gt 60 ] && { red "Postgres did not come up."; exit 1; }; sleep 2
  done
  local db user
  db="$(env_value POSTGRES_DB)"; user="$(env_value POSTGRES_USER)"
  compose exec -T postgres psql -U "$user" -d postgres -v ON_ERROR_STOP=1 \
    -c "DROP DATABASE IF EXISTS \"$db\";" -c "CREATE DATABASE \"$db\" OWNER \"$user\";"
  sudo cat "$folder/$dump" | compose exec -T postgres pg_restore -U "$user" -d "$db" --no-owner --no-privileges
  echo "Starting the stack..."
  compose up -d
  tries=0
  until compose exec -T app python -c "import sys; sys.exit(0)" >/dev/null 2>&1; do
    tries=$((tries + 1)); [ "$tries" -gt 60 ] && { red "The app did not come up."; exit 1; }; sleep 2
  done

  # The after-restore step, and the report.
  echo
  app_command after_restore "${snap_id:-$snapshot}" "$snap_time" 2>/dev/null | grep -v procrastinate
  echo
  green "Restored to Snapshot ${snap_id:-$snapshot} ($snap_time)."
  echo "  Now:  docker compose run --rm whisperx pull    (the model cache is not backed up)"
  echo "  then: ./transcribe check"
  sudo rm -rf "$work"
}

cmd_restore_drill() {
  need_env
  backup_on || { amber "BACKUP_TARGET is empty, so there is nothing to drill."; exit 0; }
  local started data drill step
  started="$(date +%s)"
  data="$(env_value APP_DATA_DIR)"
  drill="$(env_value DRILL_DIR)"
  [ -n "$drill" ] || drill="${data%/}-drill"

  drill_failed() {
    red "Restore drill failed at $1."
    app_command record_drill failed --step "$1" --duration "$(( $(date +%s) - started ))" 2>/dev/null | grep -v procrastinate || true
    drill_teardown
    exit 1
  }
  # The folder is emptied by root, never by a glob: a star after the folder
  # is expanded by the shell of whoever runs this, who may not look inside a
  # folder that is the app's account's alone, so it expanded to nothing and
  # removed nothing, and every drill built on the last one's leftovers.
  empty_the_drill_folder() {
    sudo test -d "$drill" || return 0
    sudo find "$drill" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
  }
  drill_teardown() {
    DRILL_DIR="$drill" docker compose -p transcribe-drill -f "$HERE/compose.yaml" -f "$HERE/compose.drill.yaml" down -v --remove-orphans >/dev/null 2>&1 || true
    empty_the_drill_folder
  }

  # 1. Room: the Snapshot's size plus the floor. The folder starts empty, so
  # an earlier drill that was interrupted leaves nothing for this one to find.
  step="room"
  drill_teardown
  sudo install -d -o "$APP_USER" -g "$APP_USER" -m 0700 "$drill" "$drill/data" "$drill/data/backup" "$drill/data/cases"
  # Postgres runs as its own user inside its container and has to be able to
  # enter the folder it is given, so this one is root's at 0755, as Docker
  # would have made it; the app's account never needs to look inside.
  sudo install -d -m 0755 "$drill/postgres"
  local need free floor_gb
  need="$(restic_ro stats latest --mode restore-size --json 2>/dev/null | grep -o '"total_size":[0-9]*' | head -1 | cut -d: -f2)" || true
  free="$(df --output=avail -B1 "$data" | tail -1 | tr -d ' ')"
  floor_gb="$(app_command shell -c "from core import settings_store; print(settings_store.get('minimum_free_disk_gb'))" 2>/dev/null | grep -v procrastinate | tail -1)" || true
  if [ -n "$need" ] && [ "$free" -lt $(( need + ${floor_gb:-20} * 1024 * 1024 * 1024 )) ]; then
    drill_failed "$step: $(( free / 1073741824 )) GB free, the Snapshot needs $(( need / 1073741824 )) GB plus the ${floor_gb:-20} GB floor"
  fi

  # 2. The newest Snapshot, into the drill folder.
  step="restore into the drill folder"
  restic_rw "$drill/data" restore latest --target /restore --include /backup/backup --include /backup/cases --quiet || drill_failed "$step"
  sudo mv "$drill/data/backup/cases" "$drill/data/cases-restored" 2>/dev/null && sudo rm -rf "$drill/data/cases" && sudo mv "$drill/data/cases-restored" "$drill/data/cases"
  if sudo test -d "$drill/data/backup/backup"; then
    sudo cp -a "$drill/data/backup/backup/." "$drill/data/backup/" && sudo rm -rf "$drill/data/backup/backup"
  fi
  sudo chown -R "$APP_USER:$APP_USER" "$drill/data"
  local dump
  dump="$(sudo ls -1 "$drill/data/backup" | grep '^nightly-.*\.dump$' | sort | tail -1)" || true
  [ -n "$dump" ] || drill_failed "$step: no dump in the Snapshot"

  # 3. The throwaway project: Postgres and the app only.
  step="the drill project"
  local dc="docker compose -p transcribe-drill -f $HERE/compose.yaml -f $HERE/compose.drill.yaml"
  export DRILL_DIR="$drill"
  $dc up -d postgres >/dev/null 2>&1 || drill_failed "$step"
  local tries=0
  until $dc exec -T postgres pg_isready -U "$(env_value POSTGRES_USER)" -d postgres >/dev/null 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -gt 60 ]; then
      echo "Postgres's last words:"; $dc logs --tail 8 postgres 2>&1 | tail -8
      drill_failed "$step: Postgres did not come up"
    fi
    sleep 2
  done

  # 4. Load, migrate, check.
  step="load the dump"
  sudo cat "$drill/data/backup/$dump" | $dc exec -T postgres pg_restore -U "$(env_value POSTGRES_USER)" -d "$(env_value POSTGRES_DB)" --no-owner --no-privileges || drill_failed "$step"
  # The app's own database role, as the web container makes it at every
  # start: the dump carries the database, never the cluster's roles. The
  # image's entrypoint takes a management command as its first word, so these
  # are run the way the guides write them, not as `python manage.py`.
  step="the app's database role"
  local said
  if ! said="$($dc run --rm -T app ensure_roles 2>&1)"; then
    printf '%s\n' "$said" | tail -8; drill_failed "$step"
  fi
  step="migrate"
  if ! said="$($dc run --rm -T app migrate --skip-checks --no-input 2>&1)"; then
    printf '%s\n' "$said" | tail -8; drill_failed "$step"
  fi
  step="check against the manifest"
  if ! said="$($dc run --rm -T app drill_check /srv/data/backup/manifest.json /srv/data/cases 2>/dev/null | grep -v procrastinate)"; then
    drill_failed "$step: $(printf '%s' "$said" | head -3 | tr '\n' ';')"
  fi

  # 5 and 6. Report to the live app, tear down.
  drill_teardown
  app_command record_drill ok --duration "$(( $(date +%s) - started ))" 2>/dev/null | grep -v procrastinate || true
  green "Restore drill passed in $(( $(date +%s) - started ))s: the newest Snapshot restores and matches its manifest."
}

# The install's backup steps, and the timers -------------------------------------------

ask_the_backup() {
  cat <<'WORDS'

Backup
------
Every night the app can carry a copy of itself, encrypted, to a folder of its
own on the office's backup store over SFTP, as a dedicated account. The admin
guide's Backups chapter has the store's side: the account, the folder, the key.
Leave the target empty to run without backups; the Status page will say so.

WORDS
  local target
  target="$(ask "The backup target, as sftp:<account>@<store>:/<folder>, or empty for none" "$(env_value BACKUP_TARGET)")"
  set_env BACKUP_TARGET "$target"
  local operator
  operator="$(ask "The Operator address, told when a backup or drill fails (empty for none)" "$(env_value OPERATOR_EMAIL)")"
  set_env OPERATOR_EMAIL "$operator"
  for pair in "BACKUP_SSH_KEY_FILE ./secrets/backup_ssh_key" "BACKUP_KEY_FILE ./secrets/backup_password" "BACKUP_KNOWN_HOSTS_FILE ./secrets/backup_known_hosts"; do
    # shellcheck disable=SC2086
    set -- $pair
    [ -n "$(env_value "$1")" ] || set_env "$1" "$2"
  done
  [ -n "$(env_value BACKUP_KEEP_DAYS)" ] || set_env BACKUP_KEEP_DAYS 30
  [ -n "$(env_value BACKUP_LOCAL_DUMPS)" ] || set_env BACKUP_LOCAL_DUMPS 7
  [ -n "$(env_value BACKUP_TIME)" ] || set_env BACKUP_TIME "02:00"
  [ -n "$(env_value DRILL_TIME)" ] || set_env DRILL_TIME "04:00"

  # The three files always exist, empty when backups are off, because a
  # Compose secret whose file is missing stops the whole stack.
  # Tested through sudo: secrets/ is the app account's, mode 0700, so a plain
  # test as the person running this sees nothing there and would write empty
  # files over the real ones. An existing file, empty or not, is left alone.
  for key in BACKUP_SSH_KEY_FILE BACKUP_KEY_FILE BACKUP_KNOWN_HOSTS_FILE; do
    local file
    file="$(backup_secret_file "$(env_value "$key")")"
    sudo test -e "$file" || write_secret "$file" ""
  done
  own_the_secrets
  [ -n "$target" ] || return 0

  # The key: used when it is there (a fresh box being restored brought it from
  # the password manager), made only when it is not.
  local key_file pub
  key_file="$(backup_secret_file "$(env_value BACKUP_SSH_KEY_FILE)")"
  if ! secret_present "$key_file"; then
    echo
    amber "No key at secrets/backup_ssh_key. If the store already knows a key for this app,"
    echo "  stop here (Ctrl+C), place it with:"
    echo "    sudo install -o $APP_USER -g $APP_USER -m 0400 <the key file> $key_file"
    echo "  and run this again. Otherwise a new one is made now."
    printf 'Make a new key? (yes to make one, anything else to stop): '
    read -r make_one
    [ "$make_one" = "yes" ] || { echo "Nothing was changed."; exit 0; }
    local tmp
    tmp="$(mktemp -d)"
    ssh-keygen -q -t ed25519 -N "" -C "gideon-transcribe-backup" -f "$tmp/key"
    # Copied as a file, not through a variable: a private key needs its final
    # line break, which $(...) would strip, and ssh then calls it no key at all.
    sudo install -m 0600 "$tmp/key" "$key_file"
    pub="$(cat "$tmp/key.pub")"
    rm -rf "$tmp"
    own_the_secrets
    echo
    green "A new key was made for the backup account. Its public half, to paste into the store:"
    echo
    echo "  $pub"
    echo
    echo "  And keep the private half (secrets/backup_ssh_key) in the office's password"
    echo "  manager, in the account's record, before the first Snapshot."
  else
    echo "Using the backup key already at secrets/backup_ssh_key."
  fi

  # The repository password: generated once; a fresh box gets it from the
  # password manager before this runs, and then it is kept.
  local pass_file
  pass_file="$(backup_secret_file "$(env_value BACKUP_KEY_FILE)")"
  if ! secret_present "$pass_file"; then
    write_secret "$pass_file" "$(openssl rand -base64 36 | tr -d '\n')"
    own_the_secrets
    amber "A repository password was generated into secrets/backup_password."
    echo "  Copy it into the office's password manager now. Without it every Snapshot is unreadable."
  else
    echo "Using the repository password already at secrets/backup_password."
  fi

  # The store's host key, recorded now and compared by the installer.
  local host known
  host="$(backup_user_host "$target")"; host="${host#*@}"
  known="$(backup_secret_file "$(env_value BACKUP_KNOWN_HOSTS_FILE)")"
  if ! secret_present "$known"; then
    local scanned
    scanned="$(ssh-keyscan -T 10 -p 22 "$host" 2>/dev/null)"
    if [ -z "$scanned" ]; then
      amber "The store at $host did not answer on port 22. The host key was not recorded;"
      echo "  run './transcribe install-backup' when it is reachable."
      return 0
    fi
    write_secret "$known" "$scanned"
    own_the_secrets
    echo "The store's host key was recorded. Compare this fingerprint with the one the store's administrator knows:"
    printf '%s\n' "$scanned" | ssh-keygen -lf - 2>/dev/null | sed 's/^/  /'
  fi

  # The repository: made when there is none, used when there is.
  echo "Reaching the repository..."
  if restic_ro cat config >/dev/null 2>&1; then
    green "The repository at $target exists already and opens with this password."
  elif restic_ro init --quiet 2>/dev/null; then
    green "The repository at $target was initialised."
  else
    amber "The repository could not be reached or made. Check the store's account, folder"
    echo "  and key with './transcribe check' once the public key is in place."
  fi
  install_timers
}

cmd_install_backup() {
  need_env
  ask_the_backup
  echo
  echo "Then, with the stack up:  ./transcribe backup   and   ./transcribe restore-drill"
}

# Mail (Phase 2, Email notifications) -------------------------------------------------

ask_the_mail() {
  cat <<'WORDS'

Email
-----
The app can send plain-text mail through the office's relay: a nightly note to
each person whose cases are about to be deleted, a note when a case is shared
with or handed to them, a note when a batch finishes if they asked for one, and
reports to the Operator address about backups. Leave the relay empty to run
without mail: the app's pages show everything a message would say, but nobody
is warned by mail before a case is deleted.

WORDS
  local relay
  relay="$(ask "The mail relay's host name, or empty for no mail" "$(env_value SMTP_HOST)")"
  set_env SMTP_HOST "$relay"
  [ -n "$(env_value SMTP_PORT)" ] || set_env SMTP_PORT 25
  [ -n "$(env_value SMTP_STARTTLS)" ] || set_env SMTP_STARTTLS auto
  [ -n "$(env_value SMTP_PASSWORD_FILE)" ] || set_env SMTP_PASSWORD_FILE ./secrets/smtp_password
  # The password file always exists, empty when the relay wants none, because
  # a Compose secret whose file is missing stops the whole stack.
  local file
  file="$(backup_secret_file "$(env_value SMTP_PASSWORD_FILE)")"
  sudo test -e "$file" || write_secret "$file" ""
  if [ -z "$relay" ]; then
    own_the_secrets
    amber "  No relay: the app sends no mail at all. No retention digest, no other"
    amber "  notification, and no Operator mail. Run ./transcribe install-mail to add one."
    return 0
  fi
  local port
  port="$(ask "The relay's port" "$(env_value SMTP_PORT)")"
  set_env SMTP_PORT "$port"
  local answer
  answer="$(ask "Does the relay need a sign-in? (yes, or no)" "$( [ -n "$(env_value SMTP_USER)" ] && echo yes || echo no )")"
  if [ "$answer" = "yes" ]; then
    local user
    user="$(ask "The relay's sign-in name" "$(env_value SMTP_USER)")"
    set_env SMTP_USER "$user"
    local password="" again=""
    printf 'The relay'"'"'s password (nothing is shown as you type;\n  press Enter alone to keep the one already stored): ' >&2
    read -rs password
    echo >&2
    if [ -n "$password" ]; then
      printf 'And again: ' >&2
      read -rs again
      echo >&2
      if [ "$password" != "$again" ]; then
        red "Those did not match. Nothing was written."
        return 1
      fi
      write_secret "$file" "$password"
    fi
  else
    set_env SMTP_USER ""
  fi
  own_the_secrets
  local sender
  sender="$(ask "The sender address, shown as \"Gideon Transcribe <address>\"" "$(env_value MAIL_FROM)")"
  set_env MAIL_FROM "$sender"
  local operator
  operator="$(ask "The Operator address: replies and IT reports go there (empty for none)" "$(env_value OPERATOR_EMAIL)")"
  set_env OPERATOR_EMAIL "$operator"
  echo
  echo "With the stack up, ./transcribe check sends a test message to the Operator address."
}

cmd_install_mail() {
  need_env
  ask_the_mail
  echo
  echo "Then, with the stack up:  ./transcribe check   (it sends a test message), or"
  echo "Panel, Settings, Email, Send a test message."
}

# The check's two mail lines: the relay takes a message from this server and
# lets the sender through, proven by sending one to the Operator address; and
# the Sign-in group's members without a mail value, as a warning.
check_the_mail() {
  echo
  echo "Email"
  if [ -z "$(env_value SMTP_HOST)" ]; then
    amber "  note  SMTP_HOST is empty, so the app sends no mail"
    return 0
  fi
  local said
  said="$(app_command mail_check test 2>/dev/null | grep -v procrastinate | tail -1)" || true
  case "$said" in
    OK:*) pass "${said#OK: }" ;;
    NOTE:*) note "${said#NOTE: }" ;;
    "") fail "the app did not answer; is the stack up?" ;;
    *) fail "${said#FAIL: }" ;;
  esac
  said="$(app_command mail_check count 2>/dev/null | grep -v procrastinate | tail -1)" || true
  case "$said" in
    OK:*) pass "${said#OK: }" ;;
    NOTE:*) note "${said#NOTE: }" ;;
    "") ;;
    *) fail "${said#FAIL: }" ;;
  esac
}

install_timers() {
  # The three timers and their services, from the repository's unit files
  # with the install home and the times filled in. Nothing else is put on the
  # host: the tool is a container.
  local backup_time drill_time drill_plus
  backup_time="$(env_value BACKUP_TIME)"; backup_time="${backup_time:-02:00}"
  drill_time="$(env_value DRILL_TIME)"; drill_time="${drill_time:-04:00}"
  drill_plus="$(date -d "today $drill_time 30 minutes" +%H:%M 2>/dev/null || echo "04:30")"
  local unit
  for unit in transcribe-backup transcribe-backup-weekly transcribe-backup-drill; do
    for kind in service timer; do
      sed -e "s|__INSTALL_HOME__|$HERE|g" -e "s|__BACKUP_TIME__|$backup_time|g" \
          -e "s|__DRILL_TIME__|$drill_time|g" -e "s|__DRILL_PLUS_30__|$drill_plus|g" \
          "$HERE/systemd/$unit.$kind" | sudo tee "/etc/systemd/system/$unit.$kind" >/dev/null
    done
  done
  sudo systemctl daemon-reload
  if backup_on; then
    sudo systemctl enable --now transcribe-backup.timer transcribe-backup-weekly.timer transcribe-backup-drill.timer >/dev/null 2>&1
    green "Timers on: nightly backup at $backup_time, weekly check Sundays at $drill_time, drill the first Sunday at $drill_plus."
  else
    sudo systemctl disable --now transcribe-backup.timer transcribe-backup-weekly.timer transcribe-backup-drill.timer >/dev/null 2>&1 || true
    echo "Timers written and left off, since BACKUP_TARGET is empty."
  fi
}

cmd_install_timers() {
  need_env
  install_timers
}

# The check's backup items ----------------------------------------------------------------

check_the_backup() {
  echo
  echo "The Backup target"
  if ! backup_on; then
    amber "  note  BACKUP_TARGET is empty, so backups are off"
    return 0
  fi
  local target user_host host folder key known
  target="$(backup_target)"
  user_host="$(backup_user_host "$target")"; host="${user_host#*@}"
  folder="$(backup_folder_path "$target")"
  key="$(backup_secret_file "$(env_value BACKUP_SSH_KEY_FILE)")"
  known="$(backup_secret_file "$(env_value BACKUP_KNOWN_HOSTS_FILE)")"

  # 1. The key and the host key are present.
  if secret_present "$key"; then pass "the backup key is present"; else fail "secrets/backup_ssh_key is empty: place it from the password manager, or run ./transcribe install-backup"; return 0; fi
  if secret_present "$known"; then pass "the store's host key is recorded"; else fail "secrets/backup_known_hosts is empty: run ./transcribe install-backup"; return 0; fi
  if secret_present "$(backup_secret_file "$(env_value BACKUP_KEY_FILE)")"; then pass "the repository password is present"; else fail "secrets/backup_password is empty: place it from the password manager"; fi

  # 5. The path form: a volume path betrays an administrator account.
  case "$folder" in
    /volume*|/volumeUSB*) fail "the folder is under a volume path ($folder): the account is an administrator, and must be an ordinary account" ;;
    /*) pass "the folder is at the root of the account's view ($folder)" ;;
    *) fail "the folder ($folder) does not start with /" ;;
  esac

  # 8. The host key the store presents matches the recorded one.
  local scanned
  scanned="$(ssh-keyscan -T 10 -p 22 "$host" 2>/dev/null | sort)"
  if [ -z "$scanned" ]; then
    fail "the store at $host did not answer on port 22"
    return 0
  fi
  if [ "$(sudo sort "$known" 2>/dev/null)" = "$scanned" ]; then
    pass "the store presents the host key that was recorded"
  else
    fail "the store's host key differs from the recorded one: if the store was rebuilt on purpose, empty secrets/backup_known_hosts and run ./transcribe install-backup"
  fi

  # The rest run inside the restic container, which has ssh and sftp and the
  # key at the right mode, as a shell script; the entrypoint is overridden.
  local sshopts="-i /run/secrets/backup_ssh_key -o UserKnownHostsFile=/run/secrets/backup_known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=20"
  local script
  script=$(cat <<EOS
set -u
u="$user_host"; f="$folder"; o="$sshopts"
# 2. What the store offers.
offered=\$(ssh -o PreferredAuthentications=none -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/run/secrets/backup_known_hosts "\$u" 2>&1 | grep -o 'publickey[a-z,]*' | head -1)
echo "OFFERED:\${offered:-unknown}"
# 3. Key-only sign-in, and 4, the root listing.
root=\$(printf 'ls\n' | sftp -q -b - \$o "\$u" 2>&1)
rc=\$?
echo "LOGIN:\$rc"
echo "ROOT:\$(printf '%s' "\$root" | grep -v '^sftp>' | tr '\n' ' ')"
# 6. Write and remove, and the recycle bin.
probe="transcribe-check-\$\$.txt"
echo probe > /tmp/\$probe
printf 'cd %s\nput /tmp/%s\nls\nrm %s\nls\n' "\$f" "\$probe" "\$probe" | sftp -q -b - \$o "\$u" >/tmp/sftp-out 2>&1
echo "WRITE:\$?"
echo "AFTER:\$(grep -v '^sftp>' /tmp/sftp-out | tr '\n' ' ')"
# 7. No shell.
ssh \$o "\$u" true >/dev/null 2>&1 && echo "SHELL:yes" || echo "SHELL:no"
EOS
)
  local out
  backup_prepare
  out="$(compose --profile backup run --rm -T --entrypoint sh backup -c "$script" 2>/dev/null)"
  local offered login root write after shell
  offered="$(printf '%s\n' "$out" | sed -n 's/^OFFERED://p')"
  login="$(printf '%s\n' "$out" | sed -n 's/^LOGIN://p')"
  root="$(printf '%s\n' "$out" | sed -n 's/^ROOT://p')"
  write="$(printf '%s\n' "$out" | sed -n 's/^WRITE://p')"
  after="$(printf '%s\n' "$out" | sed -n 's/^AFTER://p')"
  shell="$(printf '%s\n' "$out" | sed -n 's/^SHELL://p')"
  [ -n "$offered" ] && echo "  note  the store offers: $offered"
  if [ "$login" = "0" ]; then pass "key-only sign-in works"; else fail "key-only sign-in was refused: the public key is not in the account's authorized_keys, or the file is not the account's own (see the admin guide)"; return 0; fi
  local extra
  extra="$(printf '%s' "$root" | tr ' ' '\n' | grep -v "^$" | grep -v "^home$" | grep -v "^${folder#/}$" | tr '\n' ' ')" || true
  if [ -z "$extra" ]; then pass "the account sees only ${folder#/} and home at its root"; else fail "the account also sees at its root: $extra (give it an explicit No access on those shared folders)"; fi
  if [ "$write" = "0" ]; then pass "a file was written to and removed from the folder"; else fail "the folder could not be written to or cleaned up"; fi
  if printf '%s' "$after" | grep -q '#recycle'; then fail "the folder has a #recycle entry: its recycle bin is on and would hoard every pruned data file"; else pass "no recycle bin in the folder"; fi
  if [ "$shell" = "no" ]; then pass "a shell is refused; SFTP goes through"; else fail "the account gets a shell: turn every application but SFTP off for it"; fi
}

# upgrade ----------------------------------------------------------------------

# The digest record ------------------------------------------------------------
#
# A tag cannot carry the digest of the image built from it, because the image
# is built after the tag exists (ADR 0013). So the release workflow records
# what each tag resolves to in the registry, one line per image as
# `name:tag@sha256:...`, and leaves the record as a git note on the tagged
# commit under refs/notes/digests. A note travels by the same fetch and the
# same key as the code, which is why it is a note and not a file on GitHub: a
# private repository hands out its release assets only to a token, and this
# server has none.

DIGESTS_REF="refs/notes/digests"

digests_recorded_for() {
  local tag="$1"
  git -C "$HERE" fetch --quiet origin "+$DIGESTS_REF:$DIGESTS_REF" 2>/dev/null || return 1
  git -C "$HERE" notes --ref="$DIGESTS_REF" show "$tag^{commit}" 2>/dev/null
}

# What the pulled images are, against what the release recorded them as. A
# registry that served other bytes under the right tag becomes a stopped
# upgrade here instead of a silent one.
verify_the_pull() {
  local tag="$1" recorded="" line image name want have ok=yes

  if ! recorded="$(digests_recorded_for "$tag")" || [ -z "$recorded" ]; then
    echo
    amber "This release carries no digest record, so the pulled images cannot be checked."
    echo "  A release has none before its workflow has finished publishing, and"
    echo "  none from before v1.0.0 has one. To trust the source and not the"
    echo "  registry:  ./transcribe upgrade $tag --build"
    return 0
  fi

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    image="${line%%@*}"
    want="${line#*@}"
    name="${image%:*}"
    have="$(docker image inspect --format '{{join .RepoDigests "\n"}}' "$image" 2>/dev/null || true)"
    if printf '%s\n' "$have" | grep -qx "$name@$want"; then
      pass "$image is the build the release recorded"
    else
      red "  FAIL  $image is not the build the release recorded"
      echo "        recorded: $want"
      echo "        pulled:   ${have:-nothing by that name}"
      ok=no
    fi
  done <<<"$recorded"

  if [ "$ok" != yes ]; then
    echo
    red "The registry served an image that is not the one this release was built as."
    echo "  Nothing has been started and the old containers are still running."
    echo "  If you trust the source and not the registry:  ./transcribe upgrade $tag --build"
    exit 1
  fi
}

# The box ledger (§5, §6, and its line 3 to Transcribe): the containerd image
# store keeps images and the build cache on the root filesystem, so an upgrade
# keeps two tags of each of this repository's images, the one it starts and
# the one it left, and prunes the build cache it made. "dev" is kept for a
# checkout that is not at a Release.
# The words this repository's two Dockerfiles leave in the build cache's
# records, and no other project's Dockerfile does: the cache is shared with the
# rest of the server (box ledger, section 5), so only records carrying one of
# these are pruned, never the whole cache.
BUILD_CACHE_WORDS="requirements|audiowaveform|g729|/opt/app|/opt/service|collectstatic|user-guide|VIRTUAL_ENV|python3-venv|libsasl2"

# A WhisperX build needs room for its 13.8 GB image and about as much cache
# again on the root filesystem, where the image store lives (box ledger, open
# item 3). Building with less than this free fills the disk and stops every
# container on the server, not only ours (2026-09-10).
ROOT_GB_TO_BUILD=40

root_gb_free() {
  df -BG --output=avail /var/lib/docker 2>/dev/null | tail -1 | tr -d ' G'
}

tidy_the_images() {
  local keep="$1" previous="$2" image
  for image in ghcr.io/tnmd-fdo/gideon-transcribe-whisperx ghcr.io/tnmd-fdo/gideon-transcribe-app; do
    docker images --format '{{.Repository}}:{{.Tag}}' "$image" 2>/dev/null \
      | grep -v -e ":${keep}\$" -e ":${previous}\$" -e ':dev$' -e ':<none>$' \
      | xargs -r docker image rm >/dev/null 2>&1 || true
  done
  # A bare `docker builder prune -f` removes only what buildx calls dangling,
  # and the records that matter (the torch install, 11.5 GB per WhisperX
  # build) are not dangling: nine of them sat on the root filesystem until it
  # filled. Pruned by this project's own words instead, through `docker buildx
  # prune`: the older `docker builder prune` takes the same flag, says
  # nothing, and prunes only the dangling records anyway (v1.36.4 used it and
  # freed nothing); `buildx` reads the pattern, as `docker buildx du` does.
  # `-a` because the records are marked shared with the image store, and
  # without it a filtered prune keeps every shared record and frees nothing
  # either; with the filter, `-a` still touches nothing outside it. The
  # records of the build just done go too: a later build was seen not to
  # reuse them (nine copies of one install), and the images carry the layers.
  docker buildx prune -a -f --filter "description~=${BUILD_CACHE_WORDS}" >/dev/null 2>&1 || true
}

build_the_images() {
  # A build that fails has to stop the upgrade: carrying on to `up -d` starts
  # the old image over a database the new code has already migrated, and
  # says nothing.
  local free
  free="$(root_gb_free)"
  if [ -n "$free" ] && [ "$free" -lt "$ROOT_GB_TO_BUILD" ]; then
    echo
    red "The root filesystem has ${free} GB free, and a build needs about ${ROOT_GB_TO_BUILD} GB."
    echo "  Building now would fill the disk, which stops every container on"
    echo "  the server. Make room first: './transcribe tidy' prunes this"
    echo "  project's build cache and its old images; 'docker system df' shows"
    echo "  what else is there. Then run the upgrade again."
    echo "  To put the checkout back: ./transcribe rollback"
    exit 1
  fi
  if ! compose build; then
    echo
    red "The build failed, so the upgrade stops here."
    echo "  The old containers are still running and nothing was replaced."
    echo "  The message above says what went wrong."
    echo "  To put the checkout back: ./transcribe rollback"
    exit 1
  fi
}

cmd_tidy() {
  # By hand, between upgrades: this project's old image tags and its build
  # cache records, nothing of anybody else's.
  need_env
  local tag before
  tag="$(env_value RELEASE_TAG)"
  before="$(git -C "$HERE" describe --tags --abbrev=0 "${tag}^" 2>/dev/null || echo "")"
  echo "Before: $(root_gb_free) GB free on the root filesystem"
  tidy_the_images "$tag" "$before"
  echo "After:  $(root_gb_free) GB free on the root filesystem"
  echo "Kept: ${tag}${before:+ and ${before}}"
}

cmd_upgrade() {
  need_env
  local tag="" build=no before
  before="$(env_value RELEASE_TAG)"
  for one in "$@"; do
    case "$one" in
    --build) build=yes ;;
    *) tag="$one" ;;
    esac
  done

  if [ -z "$tag" ]; then
    red "Which release? For example: ./transcribe upgrade v1.0.0"
    exit 1
  fi

  echo "Upgrading to $tag"
  echo

  # 1. Never over running work.
  if running_jobs; then
    red "A job is running. An upgrade restarts the app, so wait for it."
    echo "  The queue page in the admin panel says what is running."
    exit 1
  fi
  pass "nothing is running"

  # 2. Never over somebody's local edits.
  if ! git -C "$HERE" diff --quiet || ! git -C "$HERE" diff --cached --quiet; then
    red "There are local edits to tracked files here."
    git -C "$HERE" status --short | sed 's/^/    /'
    echo "  An upgrade would lose them. Put them somewhere, then try again."
    exit 1
  fi
  pass "no local edits"

  # 3 and 4. The dump and the configuration, before anything changes.
  cmd_backup_db "pre-$tag"
  keep_the_configuration "$tag"

  # 5. The code, by fetch and checkout, which never touches an ignored file.
  echo
  echo "Fetching $tag"
  # --force: a tag that was moved upstream (the history was rewritten once,
  # before the repository went public) is taken as it now is rather than
  # refused as a clobber, which would stop the upgrade before it began.
  git -C "$HERE" fetch --tags --force --quiet
  if ! git -C "$HERE" rev-parse "$tag" >/dev/null 2>&1; then
    red "There is no release called $tag."
    exit 1
  fi
  read_the_release_lines "$tag"
  git -C "$HERE" checkout --quiet "$tag"
  pass "the checkout is at $tag"

  # What the app says it is running. Written here rather than typed, because a
  # figure somebody typed would be a guess about the checkout rather than a
  # fact about it, and the Admin panel and the audit log both print it.
  set_env RELEASE_TAG "$tag"

  # 6 and 7. The images, then up. The folders first: a release can add one
  # Caddy mounts, and Docker would create a missing mount source as root,
  # which the app could then never write into.
  make_the_data_folders
  ensure_the_token_file

  echo
  if [ "$build" = "yes" ]; then
    build_the_images
  elif compose pull --quiet; then
    pass "the images came from the registry"
    verify_the_pull "$tag"
  else
    # Nothing may be published yet, or the registry may be out of reach, and
    # both are fine: compose.yaml carries build: beside image: for both of
    # this repository's images, so they are built here instead.
    echo
    amber "The registry had nothing to give, so the images are built here."
    echo "  The WhisperX one takes ten to twenty minutes the first time."
    echo
    build_the_images
  fi
  compose up -d
  tidy_the_images "$tag" "$before"

  # Caddy's configuration is a file mounted into it, not part of its image,
  # so `up -d` leaves it running with whatever it read at startup: a changed
  # Caddyfile takes effect at the next restart and not before. That is a quiet
  # way to run one thing while believing another, and the allow-list lives in
  # that file. It is restarted every upgrade, which costs a second.
  echo
  echo "Restarting Caddy so it reads its configuration again"
  compose restart caddy

  # 8. The models, when the release says they changed.
  if models_changed "$tag"; then
    echo
    amber "This release changes the models, so they are fetched now."
    compose run --rm whisperx pull
  fi

  echo
  cmd_check
}

keep_the_configuration() {
  local tag="$1"
  local folder
  folder="$(env_value APP_DATA_DIR)/backup"
  echo "Keeping this office's configuration in $folder/config-pre-$tag.tar"
  tar -cf "/tmp/config-pre-$tag.tar" -C "$HERE" \
    .env secrets tls ca whisperx-service/.env whisperx-service/secrets 2>/dev/null || true
  sudo install -o "$APP_USER" -g "$APP_USER" -m 0600 \
    "/tmp/config-pre-$tag.tar" "$folder/config-pre-$tag.tar"
  rm -f "/tmp/config-pre-$tag.tar"
}

read_the_release_lines() {
  # Every release's notes begin with two fixed lines: whether the models
  # changed and whether the database migrates. They are read out before
  # anything is done, because they are what decides whether this upgrade is
  # a quiet one.
  local tag="$1"
  echo
  echo "What $tag says about itself:"
  git -C "$HERE" show "$tag:CHANGELOG.md" 2>/dev/null |
    sed -n "/^## $tag/,/^## /p" | grep -E '^(Models|Database):' | sed 's/^/  /' ||
    amber "  its changelog says nothing about models or the database"
  echo
}

models_changed() {
  git -C "$HERE" show "$1:CHANGELOG.md" 2>/dev/null |
    sed -n "/^## $1/,/^## /p" | grep -qE '^Models: *changed'
}

running_jobs() {
  compose exec -T app python -c "
from core.jobs import Job, JobState
raise SystemExit(0 if Job.objects.filter(state__in=JobState.LIVE).exists() else 1)
" >/dev/null 2>&1
}

# rollback ---------------------------------------------------------------------

cmd_rollback() {
  need_env
  local tag="${1:-}"
  if [ -z "$tag" ]; then
    red "Which release? For example: ./transcribe rollback v0.9.0"
    echo
    echo "  The releases this checkout knows about:"
    git -C "$HERE" tag --sort=-creatordate | head -10 | sed 's/^/    /'
    exit 1
  fi

  echo "Rolling back to $tag"
  git -C "$HERE" checkout --quiet "$tag"
  compose up -d

  echo
  amber "If the app will not start because a migration cannot be reversed,"
  echo "  restore the dump taken before the upgrade:"
  echo
  echo "    ./transcribe restore-dump $(env_value APP_DATA_DIR)/backup/pre-<the tag you left>.dump"
  echo
  cmd_check
}

cmd_restore_dump() {
  need_env
  local dump="${1:-}"
  if [ ! -f "$dump" ]; then
    red "There is no dump at ${dump:-<nothing given>}."
    exit 1
  fi

  red "This replaces everything in the database with what is in that file."
  printf '  Type the word yes to go on: ' >&2
  local said
  read -r said
  [ "$said" = "yes" ] || { echo "Nothing was done."; return 0; }

  compose stop app worker media-worker
  sudo cat "$dump" | compose exec -T postgres pg_restore \
    -U "$(env_value POSTGRES_USER)" \
    -d "$(env_value POSTGRES_DB)" \
    --clean --if-exists --no-owner
  compose up -d
  green "Restored."
}

