# The WhisperX service's settings.
#
# This is the only environment file in this folder that is ever committed.
# `./transcribe install` writes the real .env beside it and fills in the values
# in angle brackets; an office running the service on its own copies this file
# to .env and edits it by hand.
#
# Every setting here is echoed in every job result, so a Consumer can record
# exactly what produced a transcript.

# ---------------------------------------------------------------------------
# The card and the account the service runs as
# ---------------------------------------------------------------------------

# The GPU this service may use, by UUID and never by index. `nvidia-smi -L`
# lists the cards with their UUIDs. Where a second card runs something else,
# that card is never touched.
WHISPERX_GPU_UUID=<GPU UUID>

# The `transcribe` system account's numeric ids. `id transcribe` prints them.
# The container runs as this account, and the two folders below belong to it.
WHISPERX_UID=<uid>
WHISPERX_GID=<gid>

# ---------------------------------------------------------------------------
# The two folders on the server
# ---------------------------------------------------------------------------

# Both paths must be absolute. The model folder: the two ASR models, the diarization model, the alignment
# models, and the driver's compiled kernels. It can always be filled again by
# `pull`, so it is never backed up.
WHISPERX_MODELS_DIR=/replace/with/the/app-data-folder/models/whisperx

# The state folder: the job database, audio in flight, and results waiting to
# be collected. Audio is deleted the moment a job ends, and a result goes at 24
# hours whether or not it was fetched.
WHISPERX_STATE_DIR=/replace/with/the/app-data-folder/whisperx

# ---------------------------------------------------------------------------
# The two secret files
# ---------------------------------------------------------------------------

# The HuggingFace token, which the diarization model's licence gate needs. The
# install asks for it on the terminal and writes the file, mode 0400. The
# service alone reads it; the app never sees it.
HF_TOKEN_FILE=./secrets/hf_token

# The Consumer tokens: one name and token per line, with an optional `admin`
# mark. `make-token NAME` adds a line, and the service picks the change up
# without a restart.
WHISPERX_TOKENS_FILE=./secrets/tokens

# ---------------------------------------------------------------------------
# Limits and retention. The ceilings sit above any one Consumer's own limits,
# so that another application is not bound by the app's policy.
# ---------------------------------------------------------------------------

# The largest request body. Over it: 413, reason class too_large. Two gigabytes
# is over seventeen hours of the prepared 16 kHz mono WAV the service expects.
WHISPERX_MAX_UPLOAD_GB=2

# The longest audio, measured at submit. Over it: 400, reason class too_long.
WHISPERX_MAX_AUDIO_HOURS=8

# How long a job may run: the base, plus a minute for every minute of audio.
# Past that it fails with the reason class timeout and the model process is
# restarted.
WHISPERX_JOB_TIMEOUT_BASE_MINUTES=30
WHISPERX_JOB_TIMEOUT_PER_AUDIO_HOUR_MINUTES=60

# How long a result that nobody fetched is kept, and how long a job's metadata
# row (which holds no text) is kept for troubleshooting.
WHISPERX_RESULT_HOURS=24
WHISPERX_JOB_HISTORY_DAYS=30

# ---------------------------------------------------------------------------
# The engine's own settings
# ---------------------------------------------------------------------------

# How many 30-second chunks are transcribed at once. It must always be set:
# whisperx falls back to a batch of one when it is left out.
#
# 16 is what the Phase 1 benchmark gate chose. Above it, video memory keeps
# growing at about a gigabyte for every 8 of batch size while transcription
# gets under 3 per cent faster, and transcription is only about a third of a
# job, so the job barely moves. Below it, 8 costs about 6 per cent of the
# transcription speed and saves about 1.5 GB, which is the trade to make on a
# card that has other work on it.
WHISPERX_BATCH_SIZE=16

# The voice-activity thresholds, which are whisperx's own defaults. A voice
# activity decision is the only way the service can leave speech out, which is
# why the Phase 1 benchmark gate checked them on real phone calls before they
# shipped as they stand.
#
# What it found, on nine narrowband jail and office calls (2026-09-03): lower
# thresholds (0.35 and 0.25) found no more speech and no more words. Every
# file came out within about 3 per cent, and most of those the other way, so
# there is nothing to be gained by opening the gate wider. These are the
# defaults for that reason, not by inheritance.
WHISPERX_VAD_ONSET=0.50
WHISPERX_VAD_OFFSET=0.363

# The languages whose alignment models `pull` fetches, so that they are aligned
# offline from the first run. Any other language's model is fetched on first
# use if the network allows, and the job completes with segment timing only
# when it cannot be.
WHISPERX_ALIGN_LANGUAGES=en,es

# `info` is what a running service prints: job ids, Consumer names, stages,
# timings, reason classes. `debug` adds detail for IT and still prints no
# transcript text, no vocabulary, and no token values.
WHISPERX_LOG_LEVEL=info

# The time zone the service's own log lines carry. Job timestamps in the API
# are always UTC.
TZ=UTC
