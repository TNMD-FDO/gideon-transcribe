# Gideon Transcribe: the app's settings.
#
# This is the only environment file at this level that is ever committed.
# `./transcribe install` writes the real .env beside it and fills in the values
# in angle brackets; nobody copies this file by hand on a real installation.
#
# The WhisperX service has its own file, whisperx-service/.env, with its own
# example beside it.

# ---------------------------------------------------------------------------
# The address, and who may reach it
# ---------------------------------------------------------------------------

# The app's own name in the office's DNS zone, which is also the name on its
# certificate. One A record, one certificate, one name.
APP_HOSTNAME=<hostname>

# The published HTTPS port. Another reverse proxy on the server may already own
# 443, so the app answers on its own port and its address carries it.
HTTPS_PORT=8443

# The address the port is published on. The server's LAN address keeps it off
# every other interface the machine has, such as a virtual-machine bridge.
BIND_ADDRESS=0.0.0.0

# The client networks the app answers, separated by spaces. Everyone else
# gets 403, with no page and no hint that there is an app here. To mean
# everyone, which is almost never right, say `0.0.0.0/0 ::/0` in full rather
# than leaving this empty.
ALLOWED_CLIENT_CIDRS=<office CIDRs, separated by spaces>

# ---------------------------------------------------------------------------
# The folder and the account
# ---------------------------------------------------------------------------

# The App data folder: uploads, working files, the database files, the models,
# and the WhisperX service's state. It goes on the largest drive, never the OS
# drive, and every bind mount in the compose file starts here. Absolute.
APP_DATA_DIR=/replace/with/the/app-data-folder

# The `transcribe` system account's numeric ids. `id transcribe` prints them.
# Every app service runs as this account; it is never in the docker group.
APP_UID=<uid>
APP_GID=<gid>

# Every container's time zone, so that the schedules run at office-local
# times. The host itself stays on UTC.
TZ=<office time zone>

# ---------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------

POSTGRES_DB=transcribe
POSTGRES_USER=transcribe

# ---------------------------------------------------------------------------
# Secret files. Each holds one secret and nothing else. The install generates
# the random ones and asks for the two a person holds.
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY_FILE=./secrets/django_secret_key
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
WHISPERX_TOKEN_FILE=./secrets/whisperx_consumer_token

# ---------------------------------------------------------------------------
# The WhisperX service
# ---------------------------------------------------------------------------

# Where the service answers, on its own Docker network. It publishes no host
# port and has no hostname.
WHISPERX_URL=http://whisperx:8000

# ---------------------------------------------------------------------------
# The office directory
#
# Sign-in is against the office's Active Directory over LDAPS on port 636.
# Every value here is this office's own; none of it is in the code, and none
# of it is edited in the Admin panel, which shows these read-only.
#
# Set LDAP_ENABLED=false for an evaluation install with local admins only.
# ---------------------------------------------------------------------------

LDAP_ENABLED=true

# The directory by domain name, never one domain controller, so that any
# controller answers and a slow one fails over to the next.
LDAP_SERVER_URI=ldaps://example.internal:636

# The office CA root, exported as PEM. The file must exist, because the stack
# will not start without it; leave it empty for an office whose certificates
# come from a public authority, and the system trust store is used instead.
LDAP_CA_FILE=./ca/office-root.pem

# The read-only bind account, as its User logon name. It needs nothing beyond
# an ordinary domain account's read.
LDAP_BIND_USER=svc-transcribe@example.internal

# Its password, in a file of its own, mode 0400. Never in this file, never in
# the panel, never in a log.
LDAP_BIND_PASSWORD_FILE=./secrets/ldap_bind_password

# The domain's base DN, under which people are found.
LDAP_SEARCH_BASE=DC=example,DC=internal

# The two group DNs. Membership of either grants sign-in; membership of the
# admin group also makes a person an Admin. Nested membership counts for both.
# Leave the admin group blank for an install with no group-derived admins.
LDAP_SIGNIN_GROUP=CN=Gideon Transcribe Users,OU=Groups,DC=example,DC=internal
LDAP_ADMIN_GROUP=CN=Gideon Transcribe Admins,OU=Groups,DC=example,DC=internal

# ---------------------------------------------------------------------------
# Running
# ---------------------------------------------------------------------------

# INFO is what a running app prints: what happened, to which id, and how long
# it took. It never prints transcript text, file names, or anything a user
# typed.
LOG_LEVEL=INFO

# How much of the server the media work may take. Hashing, probing, the audio
# the service is sent, the playback copy, the waveform and every clip run in
# the media worker, on the processor and never on a GPU.
#
# Each ffmpeg takes every core it can see unless it is told not to, and the
# media worker runs several at once beside the web process, the queue and the
# database. These two are how an office keeps some of its server for the app.
MEDIA_THREADS_PER_JOB=8
MEDIA_CONCURRENT_JOBS=4

# The Release this server is running. Written by ./transcribe upgrade, not by
# hand: it is what the Admin panel and the audit log say the office is on, and
# a figure typed here would be a guess about the checkout rather than a fact
# about it. Leave it empty on a first install.
RELEASE_TAG=

# ---------------------------------------------------------------------------
# The AI assistant's engine
# ---------------------------------------------------------------------------
#
# The assistant is the one part of the app that talks to a model, and it never
# leaves the building: the engine is either one this office already runs (a
# shared engine) or one this stack starts itself.
#
# The engine's bearer token, written by the install. Never in this file.
LLM_API_TOKEN_FILE=./secrets/llm_api_token

# The Docker network the engine is reached on. With a shared engine this is
# that engine's own network, which llm-worker joins as an external network;
# the engine listens only there, behind its token, and publishes no port.
# Without one, the install creates this network for the engine it starts.
LLM_NETWORK=transcribe-llm

# Which compose files Compose reads. Left out entirely means compose.yaml
# alone, which is what most offices want.
#
# It must be left out and not set empty. Compose reads an empty COMPOSE_FILE
# as a path, finds the project folder, and refuses to start with "is a
# directory" and nothing else. So this line stays commented; uncomment it only
# for a shared engine.
#
# COMPOSE_FILE=compose.yaml:compose.shared-engine.yaml

# Compose profiles. `llm` starts the engine in this stack, for an office with
# no shared engine of its own. Unset means the assistant talks to a shared one.
COMPOSE_PROFILES=

# The engine this stack starts, when the `llm` profile is on. The GPU is named
# by its UUID and never by a number, because numbers move between reboots;
# `nvidia-smi -L` prints them, and ./transcribe install asks.
LLM_LOCAL_MODEL=Qwen/Qwen3.8-27B-FP8
LLM_LOCAL_GPU_UUID=<GPU UUID>
LLM_LOCAL_GPU_FRACTION=0.55
