# The app's own front door.
#
# It answers on its own port, because another reverse proxy on the server may
# already own 443, and the app's address carries the port. There is no port 80
# and no ACME: the certificate comes from the office's own authority, which
# office clients already trust.
#
# Everything an office supplies is an environment key from .env. Nothing
# office-specific is written here.

{
	# The certificate is the office's, placed by hand. Caddy is never to go
	# looking for one of its own.
	auto_https off

	# No admin API. Nothing needs to reconfigure Caddy while it runs, and an
	# open admin socket inside the network is a way in that buys nothing.
	admin off

	log {
		output stdout
		format json
	}
}

https://{$APP_HOSTNAME}:443 {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem

	# Only the office's own networks. A host firewall's default-deny protects
	# the host, not the traffic Docker forwards, so this is where the app is
	# held to the office network. Everyone else is told 403 and nothing else:
	# no page, no name, no hint that there is an app here.
	#
	# Both of these are `handle` blocks, and that matters. A Caddyfile runs its
	# directives in Caddy's own order rather than the order they are written
	# in, so a bare `respond` for the refusal would be reached after the proxy
	# had already answered, and the allow-list would let everyone through
	# while looking exactly as though it worked. `handle` blocks are mutually
	# exclusive and are taken in the order they appear.
	@outside not remote_ip {$ALLOWED_CLIENT_CIDRS}
	handle @outside {
		respond 403
	}

	# Uploads go straight to the sidecar, with no size cap on this route and
	# no buffering: Caddy streams request bodies unless it is told otherwise,
	# and a ten-gigabyte upload must never be held in memory or pass through
	# Python. The app's pre-create hook is what enforces the size limit.
	handle /files/* {
		reverse_proxy tusd:1080 {
			header_up X-Forwarded-Proto https
		}
	}

	# The media route (/media/*) arrives with the player. Until then the rest
	# is the app's.
	handle {
		request_body {
			max_size 64MB
		}
		reverse_proxy app:8000 {
			header_up X-Forwarded-Proto https
		}
	}
}
