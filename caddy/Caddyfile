# The app's own front door.
#
# It answers on its own port, because another reverse proxy on the server may
# already own 443, and the app's address carries the port. There is no port 80
# and no ACME: the certificate comes from the office's own authority, which
# office clients already trust.
#
# Everything an office supplies is an environment key from .env. Nothing
# office-specific is written here.

{
	# The certificate is the office's, placed by hand. Caddy is never to go
	# looking for one of its own.
	auto_https off

	# No admin API. Nothing needs to reconfigure Caddy while it runs, and an
	# open admin socket inside the network is a way in that buys nothing.
	admin off

	# No HTTP/3, and this is not about speed.
	#
	# Caddy listens on 443 inside its container and is published on another
	# port, because another reverse proxy on the server may already own 443.
	# It cannot know that, so with HTTP/3 on it puts `Alt-Svc: h3=":443"` on
	# every answer: an instruction to every browser that this same app can be
	# reached over HTTP/3 on port 443 of this host. It cannot. Port 443 is
	# whatever else is there, and a browser told to go and talk to it is being
	# pointed at a different service and told it is this one.
	#
	# Only TCP is published in any case, so the alternative was never reachable
	# and never anything but a wrong direction to send a browser in.
	servers {
		protocols h1 h2
	}

	log {
		output stdout
		format json
	}
}

https://{$APP_HOSTNAME}:443 {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem

	# The request record. The app's own audit log says what people did; this
	# says what was asked of the server, and for a Playback copy it is the
	# only record there is: those bytes come off the disk without passing
	# through Python, so nothing else ever sees them. The app's entrypoint
	# says "Caddy keeps the request record" and until now Caddy did not: the
	# global log block above configures Caddy's own errors, not the requests
	# it serves.
	#
	# Ids, never names. A URI here carries a Recording's id and the fixed
	# name `playback.mp4`; the file somebody uploaded is never in it.
	#
	# The health check is left out. Four lines a minute, for ever, saying
	# nothing.
	log {
		output stdout
		format json
	}
	log_skip /healthz

	# Only the office's own networks. A host firewall's default-deny protects
	# the host, not the traffic Docker forwards, so this is where the app is
	# held to the office network. Everyone else is told 403 and nothing else:
	# no page, no name, no hint that there is an app here.
	#
	# Both of these are `handle` blocks, and that matters. A Caddyfile runs its
	# directives in Caddy's own order rather than the order they are written
	# in, so a bare `respond` for the refusal would be reached after the proxy
	# had already answered, and the allow-list would let everyone through
	# while looking exactly as though it worked. `handle` blocks are mutually
	# exclusive and are taken in the order they appear.
	@outside not remote_ip {$ALLOWED_CLIENT_CIDRS}
	handle @outside {
		respond 403
	}

	# Uploads go straight to the sidecar, with no size cap on this route and
	# no buffering: Caddy streams request bodies unless it is told otherwise,
	# and a ten-gigabyte upload must never be held in memory or pass through
	# Python. The app's pre-create hook is what enforces the size limit.
	handle /files/* {
		reverse_proxy tusd:1080 {
			header_up X-Forwarded-Proto https
		}
	}

	# Playback copies, waveforms, and Clip files come off the disk with range
	# requests, so a multi-gigabyte stream never passes through Python. What
	# does pass through Python is the question of whether this session may
	# have the file: Caddy asks the app first and serves nothing until it
	# says yes.
	#
	# `no-store` on both media routes, for two reasons.
	#
	# The first is the point of this app. Without it these answers carry no
	# Cache-Control at all, so a browser keeps privileged recordings on the
	# disk of whatever machine played them, for as long as it likes, long
	# after the Login session that was allowed to see them has ended. Nothing
	# in a Workspace is meant to outlive its session and nothing is meant to
	# leave the building; a copy sitting in a browser profile does both.
	#
	# The second is that it was also breaking playback. A browser that had
	# cached part of a large recording kept being told 304 Not Modified and
	# never fetched the rest, so it played what it held and would not jump
	# anywhere else. A small recording fits whole and scrubs perfectly, which
	# is what made it look like a fault in the player.
	handle /media/* {
		# `route` and not a bare `handle`, and that matters for the same
		# reason the allow-list above is a `handle` block. Inside a plain
		# handle, Caddy sorts these directives into its own canonical order,
		# which puts the strip_prefix before the forward_auth: the app is
		# then asked about `/<user>/<recording>/<file>` with the `/media`
		# already gone, does not recognise it, and refuses every file.
		# `route` keeps the order written here.
		route {
			forward_auth app:8000 {
				uri /media-auth
			}
			header Cache-Control "private, no-store"
			root * /srv/scratch
			uri strip_prefix /media
			file_server
		}
	}

	# The same thing for a Recording kept in a Case, which lives under
	# `cases/` and not under `scratch/`. Two roots and not one, because a
	# single root over the whole App data folder would put `postgres/` and
	# `uploads/` inside a file_server's reach; Caddy is given the two folders
	# it must serve and nothing else.
	handle /case-media/* {
		route {
			forward_auth app:8000 {
				uri /media-auth
			}
			header Cache-Control "private, no-store"
			root * /srv/cases
			uri strip_prefix /case-media
			file_server
		}
	}

	handle {
		request_body {
			max_size 64MB
		}
		reverse_proxy app:8000 {
			header_up X-Forwarded-Proto https
		}
	}
}
